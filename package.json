{
  "name": "football-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "赛事预言家 MVP 核心领域层（阶段 1：项目骨架与纯领域层）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gateway:dev": "npm run build && node scripts/gateway-dev.mjs",
    "cloudfunction:build": "tsc -p tsconfig.cloudfunction.json && node scripts/write-cloudfunction-build-info.mjs",
    "cloudbase:schema": "npm run build && node scripts/cloudbase-schema.mjs",
    "logos:check": "node scripts/logos-check.mjs",
    "providers:map-teams": "node scripts/providers-map-teams.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
