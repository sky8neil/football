/* Self-contained values: WeChat custom component style isolation. */


.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; box-sizing: border-box; height: calc(64px + env(safe-area-inset-bottom)); padding: 6px 12px calc(6px + env(safe-area-inset-bottom)); display: flex; background: rgba(255,255,255,.96); border-top: 1px solid #dce6df; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
.tab-item { --icon-stroke: 1.7px; display: flex; flex: 1; min-width: 0; height: 100%; margin: 0; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-radius: 0; background: transparent; color: #52665b; font-size: 10px; font-weight: 400; line-height: 1.4; }
.tab-item::after { border: 0; }
.tab-item.selected { --icon-stroke: 2px; color: #2f8a3a; font-weight: 700; }
.tab-icon { width: 22px; height: 22px; position: relative; display: flex; align-items: center; justify-content: center; flex: none; }
.pitch-outline { position: relative; box-sizing: border-box; width: 16.5px; height: 14.5px; border: var(--icon-stroke) solid currentColor; border-radius: 3px; }
.pitch-half { position: absolute; left: 50%; top: 0; bottom: 0; border-left: var(--icon-stroke) solid currentColor; transform: translateX(-50%); }
.pitch-circle { position: absolute; left: 50%; top: 50%; width: 5.5px; height: 5.5px; box-sizing: border-box; border: var(--icon-stroke) solid currentColor; border-radius: 50%; transform: translate(-50%,-50%); }
.pitch-box { position: absolute; top: 50%; width: 3.5px; height: 6px; box-sizing: border-box; border: var(--icon-stroke) solid currentColor; transform: translateY(-50%); }
.pitch-box.left { left: 0; border-left: 0; }
.pitch-box.right { right: 0; border-right: 0; }
.ranking-outline { display: flex; align-items: flex-end; justify-content: center; width: 17.5px; height: 16px; border-bottom: var(--icon-stroke) solid currentColor; }
.rank-column { width: 4.5px; box-sizing: border-box; border: var(--icon-stroke) solid currentColor; border-bottom: 0; }
.rank-column + .rank-column { border-left: 0; }
.rank-column.low { height: 8.5px; }
.rank-column.high { height: 100%; }
.rank-column.middle { height: 11.5px; }
.person-head { position: absolute; top: 2.5px; width: 6.5px; height: 6.5px; border: var(--icon-stroke) solid currentColor; border-radius: 50%; box-sizing: border-box; }
.person-body { position: absolute; bottom: 1.5px; width: 13px; height: 10px; border: var(--icon-stroke) solid currentColor; border-bottom: 0; border-radius: 22px 22px 0 0; box-sizing: border-box; }
