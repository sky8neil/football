@import "../../styles/secondary-pages.wxss";

.page {
  padding: 24rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.num {
  font-variant-numeric: tabular-nums;
}

.glass-card.strong {
  background: rgba(255, 255, 255, 0.78);
}

.profile-hero {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-core {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.emblem-ring {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: conic-gradient(#3aa37a 0deg 260deg, rgba(22, 48, 36, 0.1) 260deg 360deg);
  flex: none;
}

.emblem-ring.deleted {
  background: rgba(113, 128, 150, 0.22);
}

.emblem-inner {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-positive);
}

.emblem-inner.is-deleted {
  color: var(--text-muted);
}

.emblem-logo {
  width: 68rpx;
  height: 68rpx;
}

.identity-copy {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.display-name {
  font-size: 36rpx;
  font-weight: 750;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.chip-brand {
  background: var(--color-brand-soft);
  color: var(--color-brand-primary-pressed);
}

.chip-hit {
  background: var(--color-state-hit-soft);
  color: var(--color-state-locked);
}

.chip-done {
  background: var(--color-state-done-soft);
  color: var(--text-secondary);
}

.gender-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  flex: none;
}

.gender-badge.is-male {
  background: rgba(37, 99, 235, 0.12);
  color: #2563eb;
}

.gender-badge.is-female {
  background: rgba(225, 29, 72, 0.12);
  color: #e11d48;
}

.title-sub {
  font-size: 24rpx;
  color: var(--text-positive);
  font-weight: 650;
  margin-top: 4rpx;
}

.team-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(22, 48, 36, 0.08);
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.team-pill-logo {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.deleted-banner {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-xs);
  background: var(--color-state-done-soft);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.dark-hero {
  background: var(--secondary-dark);
  border: 2rpx solid var(--secondary-dark-border);
  border-radius: var(--radius-card);
  box-shadow: var(--secondary-dark-shadow);
  color: var(--white);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.season-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.season-copy {
  flex: 1;
  min-width: 0;
}

.season-eyebrow {
  font-size: 22rpx;
  color: var(--secondary-accent);
  font-weight: 600;
}

.season-level {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.season-badge {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(185, 240, 143, 0.16);
  border: 2rpx solid rgba(185, 240, 143, 0.35);
  color: var(--secondary-accent);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  flex: none;
}

.stats-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}

.metric-box {
  padding: 20rpx 12rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.56);
  border: 2rpx solid rgba(255, 255, 255, 0.75);
}

.metric-val {
  display: block;
  font-size: 44rpx;
  font-weight: 750;
  color: var(--text-primary);
  line-height: 1.15;
}

.metric-val.positive {
  color: var(--text-positive);
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.level-rows {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(22, 48, 36, 0.08);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.kv-label {
  color: var(--text-secondary);
}

.kv-val {
  font-weight: 700;
  color: var(--text-primary);
}

.privacy-note {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 状态面板 */
.state-panel {
  text-align: center;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.state-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: var(--color-brand-soft);
  color: var(--text-positive);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}

.state-icon.is-muted {
  background: var(--color-state-done-soft);
  color: var(--text-muted);
}

.state-icon.is-danger {
  background: #fef3f2;
  color: #b42318;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 36rpx;
}

.loading .state-desc {
  margin-bottom: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  margin: 0;
  box-sizing: border-box;
}

.btn-primary {
  min-width: 296rpx;
  height: 80rpx;
  padding: 0 36rpx;
  background: var(--cta-background);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-floating);
}

.btn-ghost {
  min-width: 256rpx;
  height: 72rpx;
  padding: 0 32rpx;
  background: var(--surface-ghost);
  border: 2rpx solid var(--border-glass-strong);
  color: var(--text-primary);
  font-weight: 600;
  font-size: 26rpx;
}
