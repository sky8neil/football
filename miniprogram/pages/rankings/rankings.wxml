<view class="page">
  <view class="page-heading">排行榜</view>

  <scroll-view class="board-tabs" scroll-x enable-flex>
    <button class="board-tab {{board === 'week' ? 'active' : ''}}" data-board="week" bindtap="onBoardTap">周榜</button>
    <button wx:if="{{showCareerBoard}}" class="board-tab {{board === 'career' ? 'active' : ''}}" data-board="career" bindtap="onBoardTap">生涯榜</button>
    <button wx:if="{{showStrengthBoard}}" class="board-tab {{board === 'strength' ? 'active' : ''}}" data-board="strength" bindtap="onBoardTap">实力榜</button>
    <button wx:if="{{showSeasonBoard}}" class="board-tab {{board === 'season' ? 'active' : ''}}" data-board="season" bindtap="onBoardTap">赛季榜</button>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'guest'}}" class="guest-state">
    <view class="guest-heading">{{guestText}}</view>
    <view wx:for="{{guestBars}}" wx:key="*this" class="guest-row">
      <view class="guest-number"></view><view class="guest-name"></view><view class="guest-value"></view>
    </view>
  </view>
  <view wx:elif="{{state === 'userDeleted'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'validationError' || state === 'error'}}" class="state-panel">
    <text>{{errorMessage}}</text>
    <button bindtap="onRetry">重试</button>
  </view>
  <view wx:elif="{{state === 'rateLimited'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'list'}}" class="ranking-content">
    <view class="scope-row">
      <button class="scope-option {{scope === 'global' ? 'selected' : ''}}" data-scope="global" bindtap="onScopeTap">{{scopeGlobalText}}</button>
      <picker
        wx:if="{{showGroupScope && groups.length > 0}}"
        class="group-picker"
        mode="selector"
        range="{{groupNames}}"
        value="{{selectedGroupIndex}}"
        bindchange="onGroupChange"
      >
        <view class="scope-option {{scope === 'group' ? 'selected' : ''}}">{{scopeGroupText}} · {{groupNames[selectedGroupIndex]}}</view>
      </picker>
      <button
        wx:elif="{{showGroupScope}}"
        class="scope-option locked"
        data-scope="group"
        bindtap="onScopeTap"
      >{{groupLockedText}}</button>
    </view>

    <view class="filters">
      <picker wx:if="{{board === 'week' && weekOptions.length > 1}}" mode="selector" range="{{weekOptionLabels}}" value="{{selectedWeekIndex}}" bindchange="onWeekChange">
        <view class="filter-control">{{weekOptionLabels[selectedWeekIndex]}} <text>⌄</text></view>
      </picker>
      <picker wx:if="{{board === 'season' && availableLevelSeasons.length > 1}}" mode="selector" range="{{availableLevelSeasons}}" value="{{selectedSeasonIndex}}" bindchange="onSeasonChange">
        <view class="filter-control">{{selectedLevelSeasonId}} <text>⌄</text></view>
      </picker>
      <view class="entry-count">{{entryCount}} 位入榜</view>
    </view>

    <view wx:if="{{view.showRecap}}" class="notice recap">{{view.recapText}}</view>
    <view wx:for="{{view.notices}}" wx:key="kind" class="notice {{item.kind}}">
      <text>{{item.text}}</text>
      <button wx:if="{{item.kind === 'invite'}}" class="notice-action" bindtap="onInviteTap">{{inviteActionText}}</button>
    </view>

    <view wx:if="{{me}}" class="me-panel">
      <view class="me-title">我的排行</view>
      <view class="me-status">{{me.statusText}}</view>
      <view wx:if="{{me.status === 'not_eligible'}}" class="me-detail">已参与等级赛季 {{me.seasons_participated}} 个</view>
      <view wx:if="{{me.status === 'ranked' && me.rank !== null}}" class="me-detail">第 {{me.rank}} 名<text wx:if="{{board === 'strength'}}"> · 共 {{entryCount}} 人</text></view>
      <view wx:if="{{me.status === 'ranked' && me.top_percent !== null}}" class="me-detail">全站前 {{me.top_percent}}%</view>
      <view wx:if="{{me.status === 'below_threshold'}}" class="me-detail">还需有效预测 {{me.remaining_valid_predictions}} 场</view>
    </view>

    <view class="updated" wx:if="{{view.updatedText}}">{{view.updatedText}}</view>

    <view wx:if="{{entryCount === 0}}" class="empty-state">
      <text>{{view.emptyText}}</text>
      <button wx:if="{{view.emptyKind === 'week_global' || view.emptyKind === 'week_group'}}" bindtap="onGoPredict">{{goPredictText}}</button>
    </view>

    <view wx:if="{{view.showPodium && podiumItems.length > 0}}" class="podium">
      <view wx:for="{{podiumItems}}" wx:key="user_id" class="podium-place place-{{item.rank}}">
        <text class="place-label">{{item.placeText}}</text>
        <text class="podium-name">{{item.display_name}}</text>
        <text class="podium-score">{{item.mainValue}}</text>
      </view>
    </view>

    <view wx:if="{{view.listTitle && entryCount > 0}}" class="list-title">{{view.listTitle}}</view>
    <view wx:for="{{listItems}}" wx:key="user_id" class="ranking-row">
      <text class="rank-number">{{item.rank}}</text>
      <view class="person">
        <text class="person-name">{{item.display_name}}</text>
        <text class="person-meta">{{item.favoriteTeamText}} · Lv{{item.career_level}}</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{item.mainValue}}</text>
        <text class="metric-label">{{item.countValue}} {{item.countLabel}}</text>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <button wx:if="{{hasMore}}" class="more" bindtap="onMore" disabled="{{loadingMore}}">
      {{loadingMore ? '加载中…' : '加载更多'}}
    </button>
    <view wx:if="{{board === 'week'}}" class="week-hint">{{weekWindowHint}}</view>
  </view>
</view>
