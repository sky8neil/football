<view class="page variant-1 exploration-1" style="--native-header-height:{{headerHeight}}px">
  <image class="stadium-background" src="/assets/images/baseline-pitch.webp" mode="aspectFill" /><view class="stadium-overlay"></view>
  <view class="secondary-content">
    <view class="welcome"><view class="avatar welcome-fallback">{{avatarText || '球'}}</view><view class="welcome-copy"><text class="html-b">{{nickname || '你好'}}，今天看哪场？</text><text class="html-small">每一次预测，都是对足球的理解</text></view><view wx:if="{{currentUserId}}" class="welcome-id num" aria-label="用户 ID {{currentUserId}}">ID {{currentUserId}}</view></view>
    <view class="content">
      <view class="page-heading"><view><view class="html-h1">排行榜</view><view class="html-p">让每一次判断，都有回响。</view></view><view class="heading-actions"><button class="scope-chip" bindtap="onScopeSheet"><text>{{scope === 'group' ? groupNames[selectedGroupIndex] : '全站'}}</text><text>⌄</text></button><button class="rule-button" bindtap="onRulesTap" aria-label="查看排行榜规则">?</button></view></view>
      <view class="board-tabs"><button class="{{board === 'week' ? 'active' : ''}}" data-board="week" aria-selected="{{board === 'week'}}" bindtap="onBoardTap">本周榜<view wx:if="{{board === 'week'}}" class="tab-underline" /></button><button wx:if="{{showSeasonBoard}}" class="{{board === 'season' ? 'active' : ''}}" data-board="season" aria-selected="{{board === 'season'}}" bindtap="onBoardTap">赛季榜<view wx:if="{{board === 'season'}}" class="tab-underline" /></button><button wx:if="{{showStrengthBoard}}" class="{{board === 'strength' ? 'active' : ''}}" data-board="strength" aria-selected="{{board === 'strength'}}" bindtap="onBoardTap">实力榜<view wx:if="{{board === 'strength'}}" class="tab-underline" /></button><button wx:if="{{showCareerBoard}}" class="{{board === 'career' ? 'active' : ''}}" data-board="career" aria-selected="{{board === 'career'}}" bindtap="onBoardTap">生涯榜<view wx:if="{{board === 'career'}}" class="tab-underline" /></button></view>
      <view wx:if="{{board === 'week'}}" class="board-footer">{{weekWindowHint}}</view>
      <view class="board-meta"><text>{{board === 'season' ? selectedLevelSeasonId : board === 'career' ? '永久累计' : ''}}</text><picker wx:if="{{board === 'week' && weekOptions.length > 0}}" range="{{weekOptionLabels}}" value="{{selectedWeekIndex}}" bindchange="onWeekChange"><view>{{weekOptionLabels[selectedWeekIndex]}} ⌄</view></picker><picker wx:elif="{{board === 'season' && availableLevelSeasons.length > 1}}" range="{{availableLevelSeasons}}" value="{{selectedSeasonIndex}}" bindchange="onSeasonChange"><view>{{selectedLevelSeasonId}} ⌄</view></picker><text wx:else>{{view.updatedText}}</text></view>
      <view wx:if="{{state === 'loading'}}" class="loading">加载中</view>
      <view wx:elif="{{state === 'guest'}}" class="state-panel"><text>{{guestText}}</text><button bindtap="onLoginTap">登录</button></view>
      <view wx:elif="{{state !== 'list'}}" class="state-panel"><text>{{errorMessage}}</text><button wx:if="{{state === 'error' || state === 'validationError'}}" bindtap="onRetry">重试</button></view>
      <block wx:else>
        <view class="card hero"><view class="hero-top"><view class="html-h2">我的{{board === 'week' ? '本周' : board === 'season' ? '赛季' : board === 'strength' ? '实力' : '生涯'}}表现<text class="hero-scope">{{scope === 'group' ? groupNames[selectedGroupIndex] : '全站'}}</text></view><button wx:if="{{board === 'strength'}}" class="hero-help" bindtap="onScoreHelp">?</button><text wx:elif="{{board === 'week'}}" class="hero-stamp">{{selectedWeekIndex ? '历史周 · 已封榜' : '预测进行中'}}</text></view>
          <view class="hero-metrics"><view><text class="html-b num">{{standingLabel}}</text><text class="html-small">我的{{scope === 'group' ? '群内' : ''}}排名</text></view><view><text class="html-b num">{{standingValue}}</text><text class="html-small">我的{{metricLabel}}</text></view><view><text class="html-b num">{{entryCount}}</text><text class="html-small">{{scope === 'group' ? '群内' : '全站'}}入榜人数</text></view></view><view class="personal-status"><view class="html-p">{{standingStatus}}</view></view>
        </view>
        <view wx:if="{{view.showRecap}}" class="summary-note">{{view.recapText}}</view><view wx:for="{{view.notices}}" wx:key="kind" class="summary-note"><text>{{item.text}}</text><button wx:if="{{item.kind === 'invite'}}" bindtap="onInviteTap">{{inviteActionText}} ›</button></view>
        <view wx:if="{{entryCount === 0}}" class="state-panel"><text>{{view.emptyText}}</text><button wx:if="{{board === 'week'}}" bindtap="onGoPredict">{{goPredictText}}</button></view>
        <view wx:if="{{view.showPodium && podiumItems.length}}" class="podium"><view wx:for="{{podiumItems}}" wx:key="user_id" class="podium-person {{item.isWinner ? 'winner' : ''}}"><text class="podium-rank">{{item.placeText}}</text><view class="podium-avatar">{{item.display_name[0]}}</view><text class="name">{{item.display_name}}</text><view class="plinth"><text class="html-b num">{{item.mainValue}}</text><text class="html-small">{{item.mainLabel}}</text></view></view></view>
        <view wx:if="{{entryCount > 0}}" class="list-heading"><view class="html-h2">{{scope === 'group' ? '群内' : '全站'}}前 20</view><text class="html-small">按{{metricLabel}}排序</text></view>
        <view wx:if="{{entryCount > 0}}" class="card rank-list"><view class="rank-columns"><text>名次</text><text>预言者 / 有效预测</text><text>{{metricLabel}}</text></view><view wx:for="{{items}}" wx:key="user_id" class="rank-row {{item.user_id === currentUserId ? 'is-me' : ''}}"><text class="position num">{{item.rankText}}</text><view class="crest ranking-avatar">{{item.display_name[0]}}</view><view class="person"><view class="html-b">{{item.display_name}}<text class="level">Lv.{{item.career_level}}</text></view><text class="html-small">{{item.favoriteTeamText}} · {{item.countValue}} {{board === 'strength' ? '场窗口' : '场有效'}}<text wx:if="{{item.exact_hits !== null}}"> · 精确 {{item.exact_hits}} 次</text></text></view><view class="score num">{{item.mainValue}}<text class="html-small">{{board === 'strength' ? '预测评分' : '分'}}</text></view></view></view>
        <button wx:if="{{hasMore}}" class="load-more" bindtap="onMore" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : '查看第 11—20 名 ↓'}}</button><view wx:elif="{{entryCount > 0}}" class="board-footer">已展示全部公开名次 · 最多前 20 名</view><view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
      </block>
    </view>
  </view>
  <view wx:if="{{scopeSheetOpen}}" class="scope-overlay" bindtap="onScopeSheetClose"><view class="scope-dialog" catchtap="stopScopeTap"><view class="scope-dialog-heading"><text>查看范围</text><button bindtap="onScopeSheetClose" aria-label="关闭">×</button></view><scroll-view class="scope-sheet" scroll-y><button class="scope-opt {{scope === 'global' ? 'checked' : ''}}" data-scope="global" bindtap="onScopePick"><view>全站排行榜<text>所有预言家同榜竞争</text></view><text>{{scope === 'global' ? '✓' : ''}}</text></button><view wx:if="{{showGroupScope}}" class="sheet-label">我的群 · 每个群独立排名</view><button wx:if="{{showGroupScope && !groups.length}}" class="scope-opt" bindtap="onInviteTap">加入预言群 ›</button><block wx:if="{{showGroupScope}}"><button wx:for="{{groups}}" wx:key="group_id" class="scope-opt {{scope === 'group' && selectedGroupIndex === index ? 'checked' : ''}}" data-index="{{index}}" bindtap="onScopePick"><view>{{item.display_name}}<text>{{item.member_count}} 人</text></view><text>{{scope === 'group' && selectedGroupIndex === index ? '✓' : ''}}</text></button></block></scroll-view></view></view>
</view>
