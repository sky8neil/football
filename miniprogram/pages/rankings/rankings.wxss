@import "../../styles/secondary-pages.wxss";
.page {
  min-height: 100vh;
  padding: var(--space-8) var(--page-padding-inline) var(--page-padding-bottom);
  color: var(--text-primary);
  background: var(--surface-page);
}

.page-heading {
  margin-bottom: var(--space-5);
  font-size: var(--font-36);
  font-weight: var(--weight-bold);
}

.board-tabs {
  display: flex;
  white-space: nowrap;
  margin: 0 calc(0rpx - var(--page-padding-inline)) var(--space-5);
  padding: 0 var(--page-padding-inline) var(--space-2);
}

.board-tab {
  display: inline-flex;
  min-width: var(--secondary-tab-min);
  height: var(--cta-height);
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0 var(--space-2) 0 0;
  padding: 0 var(--space-5);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  background: transparent;
  font-size: var(--font-24);
}

.board-tab.active {
  color: var(--text-on-brand);
  background: var(--cta-background);
  font-weight: var(--weight-semibold);
}

.ranking-content {
  display: flex;
  flex-direction: column;
}

.scope-row,
.filters,
.filter-control,
.ranking-row,
.person,
.metric,
.me-panel,
.podium-place,
.notice,
.state-panel,
.empty-state,
.guest-state {
  display: flex;
}

.scope-row {
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.scope-option {
  min-width: var(--secondary-scope-min);
  margin: 0;
  padding: var(--space-4) var(--space-5);
  border: var(--border-hairline) solid var(--border-subtle);
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  background: var(--surface-ghost);
  font-size: var(--font-22);
  line-height: 1.2;
}

.scope-option.selected {
  color: var(--text-on-brand);
  background: var(--cta-background);
}

.scope-option.locked {
  max-width: 54%;
  color: var(--text-muted);
}

.group-picker {
  min-width: 0;
  flex: 1;
}

.filters {
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin: var(--space-2) 0 var(--space-5);
}

.filter-control {
  min-height: var(--ghost-button-height);
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  padding: 0 var(--space-5);
  border-radius: var(--radius-sm);
  background: var(--surface-ghost);
  font-size: var(--font-22);
}

.filter-control text {
  color: var(--text-muted);
}

.entry-count,
.updated {
  color: var(--text-muted);
  font-size: var(--font-22);
}

.week-hint {
  margin-top: var(--space-5);
  color: var(--text-muted);
  font-size: var(--font-22);
  text-align: center;
}

.updated {
  margin: var(--space-2) 0 var(--space-5);
  text-align: right;
}

.notice {
  min-height: var(--cta-height);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  background: var(--surface-card-strong);
  font-size: var(--font-22);
}

.notice.provisional {
  color: var(--text-positive);
}

.notice-action {
  flex: none;
  margin: 0;
  color: var(--text-primary);
  background: var(--surface-ghost);
  font-size: var(--font-20);
}

.me-panel {
  min-height: var(--secondary-row-height);
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3) var(--space-5);
  padding: var(--space-5) 0;
  border-bottom: var(--border-hairline) solid var(--border-subtle);
}

.me-title {
  width: 100%;
  font-size: var(--font-22);
  font-weight: var(--weight-semibold);
}

.me-status,
.me-detail {
  color: var(--text-secondary);
  font-size: var(--font-22);
}

.empty-state,
.state-panel,
.guest-state {
  min-height: var(--secondary-empty-height);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  padding: var(--space-8);
  color: var(--text-secondary);
  text-align: center;
}

.empty-state button,
.state-panel button {
  margin: 0;
  color: var(--text-on-brand);
  background: var(--cta-background);
}

.podium {
  display: flex;
  align-items: flex-end;
  gap: var(--space-3);
  margin: var(--space-5) 0 var(--space-7);
}

.podium-place {
  min-width: 0;
  min-height: var(--secondary-podium-height);
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--surface-card-strong);
  box-shadow: var(--shadow-sm);
}

.place-1 {
  min-height: var(--secondary-podium-first-height);
  background: var(--color-brand-soft);
}

.place-label,
.podium-score {
  color: var(--text-positive);
  font-size: var(--font-22);
  font-weight: var(--weight-semibold);
}

.podium-name {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-22);
}

.list-title {
  padding: var(--space-5) 0 var(--space-3);
  font-size: var(--font-24);
  font-weight: var(--weight-semibold);
}

.ranking-row {
  min-height: var(--secondary-row-height);
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) 0;
  border-bottom: var(--border-hairline) solid var(--border-subtle);
}

.rank-number {
  width: var(--secondary-rank-width);
  flex: none;
  color: var(--text-muted);
  text-align: center;
  font-family: var(--font-family-number);
  font-size: var(--font-24);
  font-weight: var(--weight-bold);
}

.person,
.metric {
  min-width: 0;
  flex-direction: column;
  gap: var(--space-2);
}

.person {
  flex: 1;
}

.person-name {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-24);
  font-weight: var(--weight-semibold);
}

.person-meta,
.metric-label {
  color: var(--text-muted);
  font-size: var(--font-20);
}

.metric {
  align-items: flex-end;
  flex: none;
}

.metric-value {
  font-family: var(--font-family-number);
  font-size: var(--font-26);
  font-weight: var(--weight-bold);
}

.more {
  margin: var(--space-5) 0;
  color: var(--text-primary);
  background: var(--surface-ghost);
}

.inline-error {
  margin-top: var(--space-4);
  color: var(--text-danger);
}

.guest-state {
  align-items: stretch;
  border-radius: var(--radius-card);
  background: var(--surface-card-strong);
}

.guest-heading {
  padding-bottom: var(--space-4);
  color: var(--text-muted);
  text-align: center;
}

.guest-row {
  display: flex;
  height: var(--secondary-avatar);
  align-items: center;
  gap: var(--space-4);
  border-top: var(--border-hairline) solid var(--border-subtle);
}

.guest-number,
.guest-name,
.guest-value {
  height: var(--space-5);
  border-radius: var(--radius-pill);
  background: var(--slate-200);
}

.guest-number {
  width: var(--secondary-rank-width);
}

.guest-name {
  width: 40%;
}

.guest-value {
  width: 22%;
  margin-left: auto;
}

.loading {
  min-height: var(--secondary-loading-height);
}

.page { background: var(--surface-canvas); }
.page-heading { font-size: var(--font-40); }
.board-tab { font-size: var(--font-26); }
.me-panel { padding: var(--space-6); margin-bottom: var(--space-4); border-bottom: 0; }
.me-title, .list-title { font-size: var(--font-30); }
.notice { border-radius: var(--radius-card); background: var(--secondary-glass); }
.podium { gap: var(--space-4); }
.podium-place { justify-content: flex-start; border-radius: var(--radius-card); background: var(--secondary-glass); padding-top: var(--space-6); border: var(--border-hairline) solid var(--border-glass-strong); }
.place-1 { order: 2; min-height: var(--secondary-podium-first-height); background: var(--color-brand-soft); }
.place-2 { order: 1; }
.place-3 { order: 3; }
.place-label { font-size: var(--font-20); }
.podium-name { font-size: var(--font-26); font-weight: var(--weight-bold); }
.podium-score { font-size: var(--font-44); }
.ranking-row { box-sizing: border-box; padding: var(--space-5) var(--space-4); margin-bottom: var(--space-3); }
.person-name { font-size: var(--font-26); }
.person-meta, .metric-label { font-size: var(--font-22); }
.metric-value { font-size: var(--font-44); }
.leader-card { display: flex; align-items: center; gap: var(--space-6); padding: var(--space-8); margin: var(--space-4) 0 var(--space-7); }
.leader-avatar { width: var(--secondary-avatar-large); height: var(--secondary-avatar-large); border: var(--border-hairline) solid var(--white); }
.leader-tag { font-size: var(--font-20); color: var(--text-positive); }
.leader-name { font-size: var(--font-30); font-weight: var(--weight-bold); }
.leader-score { font-size: var(--font-56); font-family: var(--font-family-number); font-weight: var(--weight-bold); }

.guest-state { background: var(--secondary-glass); }
