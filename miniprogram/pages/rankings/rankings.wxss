.summary-note {padding:11px 13px;margin:12px 0;font-size:10px;line-height:1.7;color:var(--text-secondary);background:var(--surface-ghost);border:1px solid var(--border-glass-strong);border-radius:12px}
.podium {display:grid;grid-template-columns:1fr 1.12fr 1fr;gap:8px;align-items:end;padding:14px 6px 0;margin-bottom:18px}
.podium-person {width:100%;text-align:center;padding:0;min-width:0}
