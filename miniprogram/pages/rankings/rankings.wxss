.rank-row.is-me .position {color:var(--text-positive);font-weight:800}
.load-more {width:100%;min-height:44px;margin-top:10px;border-radius:12px;background:var(--surface-ghost);border:1px solid var(--border-glass-strong);font-size:11px}
.board-footer {font-size:9px;color:var(--text-secondary);text-align:center;line-height:1.8;padding:18px 5px}
dialog .html-h2 {font-size:17px;padding-right:28px;margin-bottom:13px}
dialog .html-p {font-size:11px;line-height:1.8;margin:9px 0}
