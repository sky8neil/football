@import "../../styles/design-tokens.wxss";

/* =====================================================================
   赛事预言家 · 首页（V1 Design System 母版页）
   ---------------------------------------------------------------------
   • 视觉取值一律来自 styles/design-tokens.wxss；不要在本文件写死颜色/尺寸/时长
   • 要改视觉：先改 token 或本文件，然后跑 computed 快照回归（见 UI_DESIGN_SYSTEM.md）
       node    docs/design/scripts/home-view-model.mjs --out /tmp/hv
       python3 docs/design/scripts/extract-home-visuals.py --views /tmp/hv --out after.json
       python3 docs/design/scripts/diff-home-visuals.py before.json after.json
   • 2026-09-26 起：原先「末尾追加块覆盖前面的玻璃参数」的双真相写法已合并为单一真相，
     避免出现「某个 token 表面被引用、实际被后面的规则整条覆盖」查不出来的情况。
   • 刻意保留的字面量都带 ✂︎ 注释说明原因。
   ===================================================================== */

/* —— 页面骨架 —— */
page { background: var(--surface-canvas); color: var(--text-primary); font-family: var(--font-family-cn); }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: var(--page-padding-bottom); background: var(--surface-page); position: relative; overflow: hidden; }
/* 背景图层：绝对定位铺满，压在所有内容之下。
   注 1：WXSS 的 background-image 不支持本地图片路径，背景只能走 <image> 组件层。
   注 2：.page 的 --surface-page 渐变是被球场照片盖住的**兜底底色**（图片加载失败时才可见）。 */
.page-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0; }
.decor-arc { position: absolute; z-index: 0; left: -18%; top: 336rpx; width: 136%; height: 440rpx; border: var(--border-hairline) solid rgba(63,138,72,.12); border-radius: 50%; pointer-events: none; }  /* ✂︎ 装饰弧线：偏移/尺寸是单点装饰值，不成体系 */
.results { position: relative; z-index: 1; }
.results-exit { animation: content-exit var(--duration-shift) var(--ease-standard) both; }
.results-enter { animation: content-enter var(--duration-enter) var(--ease-standard) both; }
/* 以下容器原本是静态定位，会被绝对定位的背景层盖住，必须显式抬起 */
.leagues-wrap, .dates-wrap, .hint { position: relative; z-index: 1; }

/* —— 顶栏 / 品牌行 —— */
/* 顶栏是绝对定位；.topbar-spacer 负责在流式布局里给它让位。
   spacer = 顶栏偏移 40px + 高度 44px = 84px，减去 8px 叠压 → 76px。 */
.topbar-spacer { height: calc(var(--home-spacer-top) + env(safe-area-inset-top)); }
.topbar { position: absolute; left: 0; right: 0; top: calc(env(safe-area-inset-top) + var(--topbar-offset)); height: var(--topbar-height); z-index: 2; box-sizing: border-box; display: flex; align-items: center; padding: 0 var(--page-padding-inline); }
.brand { display: flex; align-items: center; gap: var(--space-5); }
/* logo：绿底圆角方块 + 白色足球（设计稿 v8.6 .mark 的 1:1 落地）
   ⚠️ 这两条规则曾经被删掉过（61c3f43 重构顶栏时只删了样式、WXML 节点还留着），
   结果就是首页左上角一片空白、且不报错。改动顶栏时不要顺手删这两条。
   球是位图（assets/icons/icon-ball.png），源文件与生成脚本见 README §9。 */
.mark { width: var(--mark-size); height: var(--mark-size); flex: 0 0 auto; border-radius: var(--mark-radius); background: var(--mark-gradient); box-shadow: var(--shadow-mark); display: flex; align-items: center; justify-content: center; }
.mark-ball { width: var(--mark-ball-size); height: var(--mark-ball-size); }
.brand-copy { flex: 1; min-width: 0; }
/* 第一行是一句话：昵称 + 中文逗号 + 问候。两个 <text> 都是行内元素、共用同一基线。
   ⚠️ 昵称/问候都不要再设 display:inline-block / max-width / vertical-align ——
   微信的 <text> 是组件而非标准行内元素，那样会把同一行拆成两个盒子、出现上下错行
   （2026-09-26 实机踩到过）。超长昵称由 JS 截断（utils/nickname.js，12 字上限），
   外层整行省略只作极窄屏兜底；外层必须是块级容器且父级 min-width:0 才会生效。 */
.brand-name { display: block; font-size: var(--font-30); font-weight: var(--weight-bold); letter-spacing: -1rpx; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }  /* ✂︎ letter-spacing -1rpx 与 line-height 1.2 是品牌行专属排版微调 */
.brand-sub { color: var(--text-muted); font-weight: var(--weight-regular); }

/* —— 联赛托盘 —— */
/* 与品牌行的间距：顶栏底边 84px，托盘顶靠这里的 margin-top 撑开；
   20rpx(10px) 时托盘顶 86px、logo 底 78px → 净空 8px（2026-09-26 用户要求「分隔开一些」）。
   联赛行是顶栏之后第一个流式元素，所以改这一个值就等于「联赛行及其下方整体下移」。 */
.leagues-wrap { margin: var(--home-tray-offset) var(--page-padding-inline) 0; padding: var(--space-2) var(--space-4); min-height: var(--tray-min-height); box-sizing: border-box; display: flex; align-items: center; background: var(--surface-tray); border: var(--border-hairline) solid var(--border-glass); border-radius: var(--tray-radius); box-shadow: var(--shadow-tray); backdrop-filter: blur(var(--blur-tray)); -webkit-backdrop-filter: blur(var(--blur-tray)); }
.leagues { width: 100%; white-space: nowrap; }
.league { display: inline-flex; vertical-align: top; width: var(--tray-cell-width); min-height: var(--tray-cell-height); margin-right: var(--space-3); flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); color: var(--text-secondary); font-size: var(--font-22); font-weight: var(--weight-medium); }
.league-logo { width: var(--tray-logo-size); height: var(--tray-logo-size); opacity: .72; }   /* ✂︎ 未选中态透明度是单点观感值 */
.league.active { color: var(--text-primary); }
.league.active .league-logo { opacity: 1; }
.league.active text { position: relative; }
.league.active text::after { content: ""; display: block; width: 24rpx; height: 4rpx; margin: 6rpx auto 0; border-radius: var(--radius-pill); background: var(--color-brand-primary); }   /* ✂︎ 选中下划线尺寸是纯装饰几何 */

/* —— 日期条 —— */
/* 日期条铺满整行（2026-09-26）：日历入口已移除，日期项尺寸与间距刻意不变
   （112rpx + 12rpx，不压缩排列）—— 一屏约 5.5 个，右边缘露出半格作为「可横向滑动」的提示。 */
.dates-wrap { padding: var(--space-3) var(--page-padding-inline) 0; }
.dates { width: 100%; white-space: nowrap; }
.date { display: inline-flex; vertical-align: top; width: var(--date-width); height: var(--date-height); margin-right: var(--space-3); border-radius: var(--date-radius); flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); color: var(--text-secondary); }
.date-label { font-size: var(--font-20); line-height: 1; }
.date-num { color: var(--text-primary); font-family: var(--font-family-number); font-size: var(--font-36); font-weight: var(--weight-heavy); line-height: 1; }
.date.active { background: var(--surface-date-active); box-shadow: var(--shadow-sm); color: var(--color-brand-primary); }
.date.active .date-num { color: var(--color-brand-primary); }

/* —— 今日提示条 —— */
.hint { display: flex; align-items: center; justify-content: space-between; padding: var(--space-5) var(--space-9) var(--space-1); color: var(--text-muted); font-size: var(--font-22); }
.hint-num,.hint-plus { color: var(--text-primary); font-family: var(--font-family-number); font-weight: var(--weight-semibold); }
/* 「最近成绩 +K」的绿色在球场照片上实测：旧绿 2.2:1 → --text-positive 5.0:1 */
.hint-plus { color: var(--text-positive); }

/* —— 比赛卡列表 —— */
.feed { height: calc(100vh - 420rpx); box-sizing: border-box; padding: var(--space-4) var(--page-padding-inline) var(--space-6); }   /* ✂︎ 420rpx 是页头各项高度的聚合值：token 化会掩盖它与上面各段布局的耦合，改布局时必须一起算 */
.match { margin-bottom: var(--match-card-gap); padding: var(--match-card-padding); position: relative; overflow: visible; background: var(--match-card-background); border: var(--match-card-border); border-radius: var(--match-card-radius); box-shadow: var(--match-card-shadow); backdrop-filter: blur(var(--match-card-blur)); -webkit-backdrop-filter: blur(var(--match-card-blur)); }
.match.is-open { background: var(--match-card-background-strong); }
.match::before { content: ""; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: var(--match-card-bar-width); border-radius: 0 6rpx 6rpx 0; background: var(--color-brand-primary); }   /* ✂︎ 竖条上下内缩等于卡内边距 */
.match.is-submitted::before { background: var(--color-state-success); }
.match.is-live::before { background: var(--color-state-live); }
.match.is-done::before { background: var(--color-state-done); }
.match-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4); padding-left: var(--space-3); }
.kick { display: flex; align-items: center; gap: var(--space-3); flex: 1; min-width: 0; color: var(--text-secondary); font-size: var(--font-22); }
.kick-time { color: var(--text-primary); font-family: var(--font-family-number); font-size: var(--font-24); font-weight: var(--weight-semibold); }
.state,.chip { min-height: var(--status-chip-height); padding: 0 var(--space-4); border-radius: var(--radius-xs); display: flex; align-items: center; font-size: var(--font-20); font-weight: var(--weight-semibold); }
.state { background: var(--color-brand-soft); color: var(--color-brand-primary-pressed); }
.state.live { background: var(--color-state-live-soft); color: var(--color-state-live); }
.state.done,.state.closed { background: var(--color-state-done-soft); color: var(--text-secondary); }
.faceoff { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-left: var(--space-3); }
.team { width: 34%; display: flex; align-items: center; gap: var(--space-3); min-width: 0; }   /* ✂︎ 34% 是对阵两侧的配比，属布局约束 */
.team.away { flex-direction: row-reverse; text-align: right; }
.crest { width: var(--crest-size); height: var(--crest-size); flex: 0 0 auto; }
.team-copy { min-width: 0; display: flex; flex-direction: column; gap: var(--space-1); }
.team-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-24); font-weight: var(--weight-semibold); }
.team-role { color: var(--text-muted); font-size: var(--font-18); }
/* 比分方块（vs 框）：**实色**，明确区别于雾白卡面 —— 不参与玻璃化。
   一旦给它加半透明白底就会和卡面糊在一起（2026-09-26 修过一次），
   所以这里显式写 backdrop-filter: none。 */
.bug { width: var(--bug-size); height: var(--bug-size); flex: 0 0 auto; border-radius: var(--bug-radius); background: var(--surface-solid); border: var(--border-hairline) solid var(--border-subtle); box-shadow: var(--shadow-bug); backdrop-filter: none; -webkit-backdrop-filter: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }   /* ✂︎ gap 6rpx 不在间距梯级上 */
.bug.dark { background: var(--surface-solid-dark); border-color: var(--border-dark); color: var(--white); }
.bug-score { font-family: var(--font-family-number); font-size: var(--font-32); font-weight: var(--weight-heavy); line-height: 1.1; }
.bug-sub { font-size: var(--font-18); color: var(--text-muted); }
.bug.dark .bug-sub { color: var(--alpha-white-60); }
.foot { min-height: 64rpx; margin-top: var(--space-4); padding-left: var(--space-3); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }   /* ✂︎ 底部行最小高度是布局约束 */
.pred { flex: 1; min-width: 0; color: var(--text-secondary); font-size: var(--font-22); }
.cta { min-height: var(--cta-height); padding: 0 var(--space-7); border-radius: var(--radius-md); background: var(--cta-background); color: var(--text-on-brand); font-size: var(--font-24); font-weight: var(--weight-bold); line-height: var(--cta-height); box-shadow: var(--shadow-floating); }
.chip.hit3 { background: var(--color-state-hit-soft); color: var(--color-state-locked); }
.chip.hit12 { background: var(--color-brand-soft); color: var(--color-brand-primary-pressed); }
.chip.miss { background: var(--color-state-done-soft); color: var(--text-muted); }

/* —— 卡内预测编辑区（原地展开）—— */
.pred-wrap { display: grid; grid-template-rows: 1fr; margin-top: var(--space-6); opacity: 1; animation: pred-open var(--duration-predict) var(--ease-emphasized) both; }
.pred-area { overflow: hidden; max-height: var(--pred-max-height); padding: var(--space-6); border: var(--pred-border); border-radius: var(--pred-radius); background: var(--pred-background); }
.pred-body { position: relative; }
.pred-editor { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.stepper-group { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
.stepper-team { display: flex; align-items: center; gap: var(--space-2); max-width: 100%; }
.stepper-team image { width: var(--stepper-team-logo-size); height: var(--stepper-team-logo-size); }
.stepper-team text { max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--font-20); }
.stepper { display: flex; align-items: center; gap: var(--space-4); }
.stepper button { width: var(--stepper-button-size); height: var(--stepper-button-size); padding: 0; border-radius: var(--radius-xs); background: var(--color-brand-soft); color: var(--color-brand-primary-pressed); font-size: var(--font-36); line-height: 54rpx; }   /* ✂︎ line-height 54rpx 是微信 button 垂直居中的经验值（56−2） */
.stepper text { width: var(--stepper-value-width); text-align: center; font-family: var(--font-family-number); font-size: var(--font-36); font-weight: var(--weight-heavy); }
.stepper-sep { font-family: var(--font-family-number); font-size: var(--font-32); color: var(--text-muted); }
.derived { margin-top: var(--space-5); text-align: center; color: var(--text-secondary); font-size: var(--font-22); }
.derived text { color: var(--color-brand-primary-pressed); font-weight: var(--weight-bold); }
.pred-hint { margin-top: var(--space-3); text-align: center; color: var(--text-muted); font-size: var(--font-18); }
.pred-actions { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); margin-top: var(--space-5); }
.submit-btn { min-height: var(--submit-button-height); padding: 0 var(--page-padding-inline); border-radius: var(--radius-sm); background: var(--color-brand-primary); color: var(--text-on-brand); font-size: var(--font-22); font-weight: var(--weight-bold); line-height: var(--submit-button-height); }
.submit-note { color: var(--text-muted); font-size: var(--font-18); }
.submit-err { margin-top: var(--space-3); color: var(--text-danger); text-align: center; font-size: var(--font-20); }
.pred-success { min-height: var(--ghost-button-height); display: flex; align-items: center; justify-content: center; color: var(--color-state-success); font-size: var(--font-26); font-weight: var(--weight-bold); animation: pred-success-in var(--duration-predict) var(--ease-standard) both; }

/* —— 更多 / 加载 / 空 / 错误 —— */
.more,.retry { margin: var(--space-3) auto var(--space-6); min-height: var(--ghost-button-height); padding: 0 var(--page-padding-inline); border-radius: var(--radius-sm); background: var(--surface-ghost); color: var(--text-secondary); font-size: var(--font-22); line-height: var(--ghost-button-height); }
.loading,.empty,.error { padding: 120rpx var(--space-10); text-align: center; color: var(--text-muted); font-size: var(--font-24); white-space: pre-line; }   /* ✂︎ 120rpx 上下留白是单点观感值 */
.retry { margin-top: var(--space-6); }
.more { display: block; }

/* —— 动效关键帧 ——
   位移量 8rpx 刻意保留字面量：@keyframes 的中间态无法被 computed 快照回归覆盖，
   抽象成 token 只会换来「改错了也测不出来」。 */
@keyframes pred-open { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pred-success-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes content-exit { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(8rpx); } }
@keyframes content-enter { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
