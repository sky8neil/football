@import "../../styles/design-tokens.wxss";

page { background: #d5ead4; color: #163024; font-family: var(--font-family-cn); }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(68rpx + env(safe-area-inset-bottom)); background: var(--background-page-default); position: relative; overflow: hidden; }
.decor-arc { position: absolute; z-index: 0; left: -18%; top: 336rpx; width: 136%; height: 440rpx; border: 2rpx solid rgba(63,138,72,.12); border-radius: 50%; pointer-events: none; }
.results { position: relative; z-index: 1; }
.results-exit { animation: content-exit .18s ease both; }
.results-enter { animation: content-enter .24s ease both; }
.topbar-spacer { height: calc(76px + env(safe-area-inset-top)); }
.topbar { position: absolute; left: 0; right: 0; top: calc(env(safe-area-inset-top) + 40px); height: 44px; z-index: 2; box-sizing: border-box; display: flex; align-items: center; padding: 0 32rpx; }
.brand { display: flex; align-items: center; gap: 20rpx; }
.brand-copy { flex: 1; min-width: 0; }
/* 第一行是一句话：昵称 + 中文逗号 + 问候。两个 <text> 都是行内元素、共用同一基线。
   ⚠️ 昵称/问候都不要再设 display:inline-block / max-width / vertical-align ——
   微信的 <text> 是组件而非标准行内元素，那样会把同一行拆成两个盒子、出现上下错行
   （2026-09-26 实机踩到过）。超长昵称由外层整行省略兜底，不做逐段限宽。
   外层必须是块级容器（view 本身即 block），且父级要 min-width:0，省略才会生效。 */
.brand-name { display: block; font-size: 30rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brand-sub { color: var(--color-text-muted); font-weight: 400; }
.leagues-wrap { margin: 4rpx 32rpx 0; padding: 8rpx 16rpx; min-height: 112rpx; box-sizing: border-box; display: flex; align-items: center; background: rgba(255,255,255,.46); border: 2rpx solid rgba(255,255,255,.74); border-radius: 40rpx; box-shadow: inset 0 2rpx 0 rgba(255,255,255,.82),0 12rpx 32rpx rgba(47,106,62,.05); }.leagues { width: 100%; white-space: nowrap; }.league { display: inline-flex; vertical-align: top; width: 104rpx; min-height: 92rpx; margin-right: 12rpx; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; font-weight: 600; }.league-logo { width: 56rpx; height: 56rpx; opacity: .72; }.league.active { color: var(--color-text-primary); }.league.active .league-logo { opacity: 1; }.league.active text { position: relative; }.league.active text::after { content: ""; display: block; width: 24rpx; height: 4rpx; margin: 6rpx auto 0; border-radius: 99rpx; background: var(--color-primary); }
/* 日期条铺满整行（2026-09-26）：移除右侧日历按钮，日期条独占整行宽度；
   日期项尺寸与间距刻意保持不变（112rpx + 12rpx），不压缩排列 ——
   一屏约 5.5 个，边缘露出半格作为「可横向滑动」的提示。 */
.dates-wrap { padding: 12rpx 32rpx 0; }.dates { width: 100%; white-space: nowrap; }.date { display: inline-flex; vertical-align: top; width: 112rpx; height: 96rpx; margin-right: 12rpx; border-radius: 28rpx; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--color-text-secondary); }.date-label { font-size: 20rpx; line-height: 1; }.date-num { color: var(--color-text-primary); font-family: var(--font-family-number); font-size: 36rpx; font-weight: 750; line-height: 1; }.date.active { background: #fff; box-shadow: var(--shadow-sm); color: var(--color-primary); }.date.active .date-num { color: var(--color-primary); }
.hint { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 36rpx 4rpx; color: var(--color-text-muted); font-size: 22rpx; }.hint-num,.hint-plus { color: var(--color-text-primary); font-family: var(--font-family-number); font-weight: 650; }.hint-plus { color: var(--color-success); }
.feed { height: calc(100vh - 420rpx); box-sizing: border-box; padding: 16rpx 32rpx 24rpx; }.match { margin-bottom: 20rpx; padding: 24rpx 24rpx 24rpx 28rpx; position: relative; overflow: visible; background: #fff; border: 2rpx solid rgba(255,255,255,.92); border-radius: 32rpx; box-shadow: var(--shadow-card); }.match.is-open { background: linear-gradient(180deg,#fff 0%,#f4fbf0 100%); }.match::before { content: ""; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: 6rpx; border-radius: 0 6rpx 6rpx 0; background: var(--color-primary); }.match.is-submitted::before { background: var(--color-success); }.match.is-live::before { background: var(--color-live); }.match.is-done::before { background: var(--color-finished); }.match-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; padding-left: 12rpx; }.kick { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; color: var(--color-text-secondary); font-size: 22rpx; }.kick-time { color: var(--color-text-primary); font-family: var(--font-family-number); font-size: 24rpx; font-weight: 650; }.state,.chip { min-height: 40rpx; padding: 0 16rpx; border-radius: 16rpx; display: flex; align-items: center; font-size: 20rpx; font-weight: 650; }.state { background: var(--color-primary-soft); color: var(--color-primary-pressed); }.state.live { background: #fff1e8; color: var(--color-live); }.state.done,.state.closed { background: var(--sp-slate-200); color: var(--color-text-secondary); }
.faceoff { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding-left: 12rpx; }.team { width: 34%; display: flex; align-items: center; gap: 12rpx; min-width: 0; }.team.away { flex-direction: row-reverse; text-align: right; }.crest { width: 72rpx; height: 72rpx; flex: 0 0 auto; }.team-copy { min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }.team-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 650; }.team-role { color: var(--color-text-muted); font-size: 18rpx; }.bug { width: 112rpx; height: 112rpx; flex: 0 0 auto; border-radius: 28rpx; background: linear-gradient(180deg,#f4fbf0,#e8f8df); border: 2rpx solid var(--color-border); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }.bug.dark { background: linear-gradient(180deg,#1a2b44,#122033); border-color: #122033; color: #fff; }.bug-score { font-family: var(--font-family-number); font-size: 32rpx; font-weight: 750; line-height: 1.1; }.bug-sub { font-size: 18rpx; color: var(--color-text-muted); }.bug.dark .bug-sub { color: rgba(255,255,255,.6); }
.foot { min-height: 64rpx; margin-top: 16rpx; padding-left: 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.pred { flex: 1; min-width: 0; color: var(--color-text-secondary); font-size: 22rpx; }.cta { min-height: 72rpx; padding: 0 28rpx; border-radius: 20rpx; background: linear-gradient(180deg,#9ee48a,#62c453); color: #163024; font-size: 24rpx; font-weight: 700; line-height: 72rpx; box-shadow: var(--shadow-floating); }.chip.hit3 { background: #e8fbf8; color: #0b7f70; }.chip.hit12 { background: var(--color-primary-soft); color: var(--color-primary-pressed); }.chip.miss { background: var(--sp-slate-200); color: var(--color-text-muted); }
.pred-wrap { display: grid; grid-template-rows: 1fr; margin-top: 24rpx; opacity: 1; animation: pred-open .32s cubic-bezier(.4,0,.2,1) both; }.pred-area { overflow: hidden; max-height: 520rpx; padding: 24rpx; border: 2rpx solid var(--color-border); border-radius: 24rpx; background: rgba(255,255,255,.72); }.pred-body { position: relative; }.pred-editor { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.stepper-group { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }.stepper-team { display: flex; align-items: center; gap: 8rpx; max-width: 100%; }.stepper-team image { width: 40rpx; height: 40rpx; }.stepper-team text { max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; }.stepper { display: flex; align-items: center; gap: 16rpx; }.stepper button { width: 56rpx; height: 56rpx; padding: 0; border-radius: 16rpx; background: var(--color-primary-soft); color: var(--color-primary-pressed); font-size: 36rpx; line-height: 54rpx; }.stepper text { width: 40rpx; text-align: center; font-family: var(--font-family-number); font-size: 36rpx; font-weight: 750; }.stepper-sep { font-family: var(--font-family-number); font-size: 32rpx; color: var(--color-text-muted); }.derived { margin-top: 20rpx; text-align: center; color: var(--color-text-secondary); font-size: 22rpx; }.derived text { color: var(--color-primary-pressed); font-weight: 700; }.pred-hint { margin-top: 12rpx; text-align: center; color: var(--color-text-muted); font-size: 18rpx; }.pred-actions { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; margin-top: 20rpx; }.submit-btn { min-height: 68rpx; padding: 0 32rpx; border-radius: 18rpx; background: var(--color-primary); color: #163024; font-size: 22rpx; font-weight: 700; line-height: 68rpx; }.submit-note { color: var(--color-text-muted); font-size: 18rpx; }.submit-err { margin-top: 12rpx; color: var(--color-danger); text-align: center; font-size: 20rpx; }.pred-success { min-height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--color-success); font-size: 26rpx; font-weight: 700; animation: pred-success-in .32s ease both; }
.more,.retry { margin: 12rpx auto 24rpx; min-height: 64rpx; padding: 0 32rpx; border-radius: 18rpx; background: rgba(255,255,255,.72); color: var(--color-text-secondary); font-size: 22rpx; line-height: 64rpx; }.loading,.empty,.error { padding: 120rpx 40rpx; text-align: center; color: var(--color-text-muted); font-size: 24rpx; white-space: pre-line; }.retry { margin-top: 24rpx; }.more { display: block; }
@keyframes pred-open { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pred-success-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes content-exit { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(8rpx); } }
@keyframes content-enter { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }

/* =====================================================================
   首页球场背景 + 玻璃卡（2026-09-16 改版）
   视觉基线：docs/design/赛事预言家首页-高保真-v8.6-球场背景玻璃版.html
   参数：白蒙层 65% + 素材降饱和 15%（已烘进图片）｜卡片玻璃 54%
   2026-09-26 可读性修整：提高白底遮盖、调轻 blur、比分方块改回实色
   素材：assets/images/home-pitch-bg.webp（780×1386，86KB）
   重新生成素材：python3 docs/design/scripts/build-bg-assets.py
   注：WXSS 的 background-image 不支持本地图片路径，所以背景用 <image> 组件层
   ===================================================================== */
page {
  /* 文字增强档：背景图叠上来后，v8.6 原有的 #5b7166 / #86a092 在这张图上只有
     1.1~4.7:1（小字会糊），压深一档后实测 5.0~7.9:1。
     要恢复 v8.6 原色，删掉下面两行即可。 */
  --color-text-secondary: #3b4f43;
  --color-text-muted: #42564a;
}

/* 背景图层：铺满页面，压在所有内容之下 */
.page-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0; }

/* 以下内容原本是静态定位，会被绝对定位的背景层盖住，必须显式抬起 */
.leagues-wrap, .dates-wrap, .hint { position: relative; z-index: 1; }

/* —— 玻璃卡：轻雾白 + 模糊（2026-09-26 可读性修整）——
   分工：模糊负责柔化草地纹理（观感），白底负责保证文字对比度（可读性）。
   2026-09-26 二次调整：22rpx 目视仍偏轻（卡片白底 54% 比托盘 48% 厚，
   透过来的背景少，同样 blur 观感更弱）→ 卡片提到 36rpx，白底不动。
   要削弱模糊效果请先降 blur；要提可读性请抬白底，不要用 blur 换。 */
.match { background: rgba(255,255,255,.54); border: 2rpx solid rgba(255,255,255,.88); box-shadow: 0 24rpx 60rpx rgba(23,60,35,.10), inset 0 2rpx 0 rgba(255,255,255,.60); backdrop-filter: blur(36rpx); -webkit-backdrop-filter: blur(36rpx); }
.match.is-open { background: rgba(255,255,255,.58); }

/* 比分方块（vs 框）：保持实色，明确区别于雾白卡面 —— 不参与玻璃化 */
.bug { background: linear-gradient(180deg,#f4fbf0,#e8f8df); border-color: var(--color-border); box-shadow: 0 4rpx 12rpx rgba(31,84,45,.08); backdrop-filter: none; -webkit-backdrop-filter: none; }

/* 卡内预测编辑区仍走玻璃，但比卡面稍实以保证输入区清楚 */
.pred-area { background: rgba(255,255,255,.50); border-color: rgba(255,255,255,.66); }

/* 联赛托盘：轻雾白，比卡片略透，仍能隐约看到球场 */
.leagues-wrap { background: rgba(255,255,255,.48); border-color: rgba(255,255,255,.82); backdrop-filter: blur(14rpx); -webkit-backdrop-filter: blur(14rpx); }

/* 日期选中态保持实心白，保证可读 */
.date.active { background: #fff; }

/* “最近成绩 +K” 的绿色在照片背景上实测仅 2.2:1，换深绿后 5.0:1 */
.hint-plus { color: #1a5c26; }
