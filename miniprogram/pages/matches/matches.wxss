.page {
  min-height: 100vh;
  padding: 0 0 24rpx;
  background:
    radial-gradient(120% 56% at 92% -8%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 46%),
    radial-gradient(80% 40% at 0% 18%, rgba(126,213,111,0.22) 0%, rgba(126,213,111,0) 55%),
    linear-gradient(180deg, #f4fbf1 0%, #eef8ef 42%, #f3faf2 100%);
  color: #163024;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx 16rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #9ee48a 0%, #4caf50 100%);
  box-shadow: 0 16rpx 32rpx rgba(63, 138, 72, 0.28), inset 0 2rpx 0 rgba(255,255,255,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mark-ring {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  line-height: 1.15;
}

.brand-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #86a092;
  letter-spacing: 1.2rpx;
}

.leagues-wrap {
  margin: 4rpx 32rpx 0;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.46);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 40rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.82), 0 12rpx 32rpx rgba(47, 106, 62, 0.05);
  min-height: 112rpx;
  box-sizing: border-box;
}

.leagues {
  width: 100%;
  white-space: nowrap;
}

.league {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  padding: 4rpx 12rpx 0;
  margin-right: 16rpx;
  color: #5b7166;
  font-size: 22rpx;
  font-weight: 600;
  background: transparent;
}

.league-logo {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
}

.league-logo.pl { background: linear-gradient(180deg, #3d195b, #6c1d45); }
.league-logo.ll { background: linear-gradient(180deg, #ee8707, #c81d25); }
.league-logo.l1 { background: linear-gradient(180deg, #091c3e, #122b5a); }
.league-logo.csl { background: linear-gradient(180deg, #ff4d4f, #c81d25); }

.league.active {
  color: #163024;
}

.league.active::after {
  content: "";
  width: 24rpx;
  height: 4rpx;
  margin-top: 6rpx;
  border-radius: 99rpx;
  background: #7ed56f;
}

.dates-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 32rpx 0;
}

.dates {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.date {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 96rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  color: #5b7166;
}

.date-label {
  font-size: 20rpx;
  line-height: 1;
}

.date-num {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 750;
  letter-spacing: -1.2rpx;
  line-height: 1;
  color: #163024;
}

.date.active {
  background: #ffffff;
  box-shadow: 0 20rpx 56rpx rgba(63, 138, 72, 0.10);
  color: #7ed56f;
}

.date.active .date-num { color: #7ed56f; }

.cal {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.8);
  border: 1rpx solid #dcead9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #5b7166;
}

.cal-icon {
  font-size: 24rpx;
  font-weight: 700;
}

.hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 4rpx;
  color: #86a092;
  font-size: 22rpx;
}

.hint-num {
  color: #163024;
  font-weight: 650;
}

.hint-plus {
  color: #718096;
  font-weight: 650;
}

.feed {
  padding: 16rpx 32rpx 0;
}

.match {
  background: #ffffff;
  border: 1rpx solid rgba(255,255,255,0.92);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(63, 138, 72, 0.10), inset 0 2rpx 0 rgba(255,255,255,0.95);
  padding: 24rpx 24rpx 24rpx 28rpx;
  position: relative;
  margin-bottom: 20rpx;
}

.match.is-open {
  background: linear-gradient(180deg, #ffffff 0%, #f4fbf0 100%);
}

.match::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #7ed56f;
}

.match.is-submitted::before { background: #3aa37a; }
.match.is-live::before { background: #f08a3c; }
.match.is-done::before { background: #718096; }
.match.is-closed::before { background: #a0aec0; }

.match-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
}

.kick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #5b7166;
  font-size: 22rpx;
  min-width: 0;
  flex: 1;
}

.kick-time {
  font-weight: 650;
  color: #163024;
  font-size: 24rpx;
}

.kick-meta {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.state {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  background: #e8f8df;
  color: #2f8a3a;
}

.state.live { background: rgba(240, 138, 60, 0.12); color: #f08a3c; }
.state.lock { background: #e8fbf8; color: #0b7f70; }
.state.done { background: #eef1f5; color: #5d6d80; }
.state.closed { background: #f3f6fb; color: #8b97a6; }

.faceoff {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}

.team {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.team.away {
  flex-direction: row-reverse;
  text-align: right;
}

.crest {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #e8f8df;
  color: #2f8a3a;
  font-size: 22rpx;
  font-weight: 800;
}

.team-copy {
  min-width: 0;
  flex: 1;
}

.team-name {
  display: block;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.team-role {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #86a092;
}

.bug {
  width: 128rpx;
  min-height: 88rpx;
  margin: 0 12rpx;
  padding: 12rpx 8rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f3f8f1;
  border: 1rpx solid #dcead9;
  flex-shrink: 0;
}

.bug-score {
  font-size: 32rpx;
  font-weight: 750;
  letter-spacing: -0.8rpx;
  line-height: 1.1;
}

.bug-sub {
  margin-top: 4rpx;
  font-size: 18rpx;
  letter-spacing: 0.08em;
  color: #86a092;
  font-weight: 650;
}

.bug.dark {
  background: linear-gradient(180deg, #1a2b44 0%, #122033 100%);
  border-color: #122033;
  color: #fff;
}

.bug.dark .bug-sub { color: rgba(255,255,255,0.55); }
.bug.live .bug-sub { color: #ffb07a; }

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-left: 12rpx;
  min-height: 64rpx;
}

.pred {
  font-size: 24rpx;
  color: #5b7166;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cta {
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #9ee48a 0%, #62c453 100%);
  color: #163024;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-shadow: 0 16rpx 32rpx rgba(63, 138, 72, 0.22), inset 0 2rpx 0 rgba(255,255,255,0.45);
}

.chip {
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 650;
  flex-shrink: 0;
  white-space: nowrap;
  background: #f3f6fb;
  color: #5b7166;
}

.chip.lock { background: #f3f6fb; color: #5b7166; }
.chip.live { background: #f3f6fb; color: #86a092; }
.chip.auth { background: #fff4e5; color: #c05621; }

.loading,
.empty,
.error {
  padding: 72rpx 24rpx;
  text-align: center;
  color: #86a092;
  font-size: 26rpx;
  white-space: pre-line;
}

.retry,
.more {
  margin-top: 24rpx;
  background: #ffffff;
  color: #163024;
  border: 1rpx solid #dcead9;
  font-size: 26rpx;
}
