<view class="page" style="--native-header-height:{{headerHeight}}px">
  <image class="page-bg" src="/assets/images/baseline-pitch.webp" mode="aspectFill"></image>
  <view class="stadium-overlay"></view>
  <view class="topbar-spacer" style="height:{{headerHeight}}px"></view>
  <view class="welcome"><view class="welcome-avatar">{{avatarText}}</view><view class="welcome-copy"><view class="welcome-title">{{nickname}}，今天看哪场？</view><view class="welcome-note">每一次预测，都是对足球的理解</view></view></view>

  <view class="leagues-wrap">
    <scroll-view class="leagues" scroll-x enable-flex scroll-with-animation>
      <view wx:for="{{leagues}}" wx:key="id" class="league {{item.id === selectedLeague ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onLeagueTap">
        <image class="league-logo" src="{{item.logo}}" mode="aspectFit"></image>
        <view class="league-label"><text>{{item.name}}</text><text wx:if="{{item.offSeason}}" class="offseason-badge">休赛</text></view>
      </view>
    </scroll-view>
  </view>

  <view class="dates-wrap">
    <scroll-view class="dates" scroll-x enable-flex scroll-with-animation>
      <view wx:for="{{dates}}" wx:key="key" class="date {{item.key === selectedDate ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onDateTap">
        <text class="date-label">{{item.label}}</text><text class="date-num">{{item.day}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="hint"><text>{{hintText}}</text><text wx:if="{{recentScore !== null && recentScore !== undefined}}">最近成绩 <text class="hint-plus">+{{recentScore}}</text></text></view>

  <view class="results {{resultsTransition}}">
    <view wx:if="{{state === 'loading'}}" class="loading">加载中</view>
    <view wx:elif="{{state === 'empty'}}" class="empty">这一天暂无比赛
点选上方日期或切换其他联赛看看</view>
    <view wx:elif="{{state === 'no-match'}}" class="no-match-card">
      <view class="empty-title">这一天暂无比赛</view>
      <view class="empty-copy">{{emptyIsBreak ? '联赛间歇中' : (nextMatch ? '可以跳到最近的比赛日继续预测' : '点选上方日期或切换其他联赛看看')}}</view>
      <button wx:if="{{nextMatch && nextMatch.inDateStrip}}" class="season-action next-match-action" data-date="{{nextMatch.date}}" bindtap="onNextMatchTap">{{nextMatch.displayText}}</button>
      <view wx:elif="{{nextMatch}}" class="next-match-note">{{nextMatch.displayText}}</view>
    </view>
    <view wx:elif="{{state === 'offseason'}}" class="offseason-card">
      <view class="offseason-title">本赛季已收官</view>
      <view class="empty-copy">{{summarySeasonId ? summarySeasonId + ' 赛季 · ' : ''}}{{offseasonInfo.leagueName}}</view>
      <view class="summary-title">我的本联赛小结</view>
      <view wx:if="{{summaryState === 'loading'}}" class="empty-copy">正在加载个人小结</view>
      <view wx:elif="{{summaryState === 'error'}}" class="summary-retry" bindtap="onSummaryRetry">小结暂时加载失败，重试</view>
      <block wx:elif="{{leagueSummary}}">
        <view wx:if="{{leagueSummary.predicted_matches > 0}}" class="summary-stats">
          <view class="summary-stat"><text>预测场次</text><text class="summary-number">{{leagueSummary.predicted_matches}}</text></view>
          <view class="summary-stat"><text>胜平负命中</text><text class="summary-number">{{leagueSummary.wdl_hits}}</text></view>
          <view class="summary-stat"><text>精确比分命中</text><text class="summary-number">{{leagueSummary.exact_hits}}</text></view>
        </view>
        <view wx:else class="empty-copy">你本赛季还没有参与该联赛预测</view>
        <view wx:if="{{leagueSummary.is_provisional}}" class="summary-provisional">结算更新中</view>
      </block>
      <view wx:else class="empty-copy">{{summaryReason === 'data_conflict' ? '数据核对中' : '小结暂不可用'}}</view>
      <view wx:if="{{offseasonInfo.nextSeasonDate}}" class="offseason-countdown">距离新赛季揭幕战还有 {{offseasonInfo.countdownDays}} 天</view>
      <view wx:else class="offseason-countdown">新赛季赛程公布后将第一时间开放预测</view>
      <button wx:if="{{offseasonInfo.activeLeagueId}}" class="season-action" data-id="{{offseasonInfo.activeLeagueId}}" bindtap="onLeagueTap">去看看正在进行的 {{offseasonInfo.activeLeagueName}} →</button>
      <button wx:if="{{levelSeasonLabel}}" class="season-action season-rankings" bindtap="onRankingsTap">查看 {{levelSeasonLabel}}榜 →</button>
      <button wx:else class="season-action season-rankings" bindtap="onRankingsTap">查看赛季排行榜 →</button>
    </view>
    <view wx:elif="{{state === 'error'}}" class="error"><text>{{errorMessage}}</text><button class="retry" bindtap="onRetry">重试</button></view>
    <scroll-view wx:elif="{{state === 'list'}}" class="feed" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}" bindtap="onFeedTap">
    <view wx:for="{{items}}" wx:key="match_id" id="match-{{item.match_id}}" class="match {{item.cardClass}} {{item.uiState}}" data-match-id="{{item.match_id}}" bindtap="onCardTap">
      <view class="match-top"><view class="kick"><text class="kick-time">{{item.timeText}}</text><text class="kick-meta">{{item.metaText}}</text></view><text wx:if="{{item.cardClass === 'is-live' || item.cardClass === 'is-done'}}" class="crowd-link" data-match-id="{{item.match_id}}" catchtap="onCardTap">{{item.crowdLinkText}}</text><view class="state {{item.stateClass}}">{{item.stateText}}</view></view>
      <view class="faceoff">
        <view class="team"><image class="crest" src="{{item.homeLogo}}" mode="aspectFit"></image><view class="team-copy"><text class="team-name">{{item.homeNameZh}}</text><text class="team-role">主队</text></view></view>
        <view class="bug {{item.bugClass}}"><text class="bug-score">{{item.scoreText}}</text><text class="bug-sub">{{item.scoreSub}}</text></view>
        <view class="team away"><image class="crest" src="{{item.awayLogo}}" mode="aspectFit"></image><view class="team-copy"><text class="team-name">{{item.awayNameZh}}</text><text class="team-role">客队</text></view></view>
      </view>
      <view class="foot"><text class="pred">{{item.predText}}</text><button wx:if="{{item.showPredict}}" class="cta" data-match-id="{{item.match_id}}" catchtap="onPredictTap">去预测 <text>→</text></button><view wx:elif="{{item.chipText}}" class="chip {{item.chipClass}}">{{item.chipText}}</view></view>

      <view wx:if="{{item.editorVisible}}" class="pred-wrap" catchtap="stopCardTap">
        <view class="pred-area">
          <view class="pred-body">
            <view wx:if="{{item.uiState !== 'submitted_locked'}}" class="pred-editor">
              <view class="stepper-group"><view class="stepper-team"><image src="{{item.homeLogo}}" mode="aspectFit"></image><text>{{item.homeNameZh}}</text></view><view class="stepper"><button catchtap="onScoreTap" data-match-id="{{item.match_id}}" data-side="home" data-delta="-1">−</button><text>{{item.draft.home}}</text><button catchtap="onScoreTap" data-match-id="{{item.match_id}}" data-side="home" data-delta="1">+</button></view></view>
              <text class="stepper-sep">:</text>
              <view class="stepper-group"><view class="stepper-team"><image src="{{item.awayLogo}}" mode="aspectFit"></image><text>{{item.awayNameZh}}</text></view><view class="stepper"><button catchtap="onScoreTap" data-match-id="{{item.match_id}}" data-side="away" data-delta="-1">−</button><text>{{item.draft.away}}</text><button catchtap="onScoreTap" data-match-id="{{item.match_id}}" data-side="away" data-delta="1">+</button></view></view>
            </view>
            <view wx:if="{{item.uiState !== 'submitted_locked'}}" class="derived">即时判定 <text>{{item.derivedResult}}</text></view>
            <view wx:if="{{item.uiState !== 'submitted_locked'}}" class="pred-hint">赛果命中 +3 · 精确比分 +12</view>
            <view wx:if="{{item.uiState !== 'submitted_locked'}}" class="pred-actions"><button class="submit-btn" catchtap="onSubmitTap" data-match-id="{{item.match_id}}" loading="{{item.uiState === 'submitting'}}" disabled="{{item.uiState === 'submitting'}}">{{item.uiState === 'submitting' ? '提交中…' : '提交预测'}}</button><text class="submit-note">提交后无法修改</text></view>
            <view wx:if="{{item.submitError}}" class="submit-err">{{item.submitError}}</view>
            <view wx:if="{{item.uiState === 'submitted_locked'}}" class="pred-success">✓ 预测已提交</view>
          </view>
        </view>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="more" bindtap="onMore" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : '更多'}}</button>
    </scroll-view>
  </view>
</view>
