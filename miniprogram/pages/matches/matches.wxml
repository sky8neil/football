<view class="page">
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'empty'}}" class="empty"></view>
  <view wx:elif="{{state === 'error'}}" class="error">{{errorMessage}}</view>
  <view wx:else>
    <view
      wx:for="{{items}}"
      wx:key="match_id"
      class="card"
      data-match-id="{{item.match_id}}"
      bindtap="onCardTap"
    >
      <view>{{item.home_team.name}}</view>
      <view>{{item.away_team.name}}</view>
      <view>{{item.kickoff_at}}</view>
      <view>{{item.match_status}}</view>
      <view wx:if="{{item.match_status === 'scheduled'}}">未开赛</view>
      <view wx:elif="{{item.match_status === 'live'}}">进行中</view>
      <view wx:elif="{{item.match_status === 'finished'}}">已结束</view>
      <view wx:elif="{{item.match_status === 'postponed'}}">延期</view>
      <view wx:elif="{{item.match_status === 'cancelled'}}">取消</view>
      <view wx:elif="{{item.match_status === 'abandoned'}}">废弃/腰斩</view>
      <view wx:if="{{item.regular_home_score !== null}}">{{item.regular_home_score}}</view>
      <view wx:if="{{item.regular_away_score !== null}}">{{item.regular_away_score}}</view>
      <view wx:if="{{item.regular_home_score === null || item.regular_away_score === null}}">待结算/暂无比分</view>
      <view>{{item.can_predict}}</view>
      <view>{{item.can_predict_reason}}</view>
      <view wx:if="{{item.can_predict && item.can_predict_reason === null}}">可提交</view>
      <view wx:elif="{{item.can_predict_reason === 'AUTH_REQUIRED'}}">需登录态</view>
      <view wx:elif="{{item.can_predict_reason === 'USER_DELETED'}}">账号已注销</view>
      <view wx:elif="{{item.can_predict_reason === 'ALREADY_SUBMITTED'}}">已提交</view>
      <view wx:elif="{{item.can_predict_reason === 'KICKOFF_UNCONFIRMED'}}">开球未确认</view>
      <view wx:elif="{{item.can_predict_reason === 'NOT_SCHEDULED'}}">非可预测赛程态</view>
      <view wx:elif="{{item.can_predict_reason === 'CLOSED'}}">预测已截止</view>
    </view>
    <button wx:if="{{hasMore}}" bindtap="onMore" disabled="{{loadingMore}}">更多</button>
  </view>
</view>
