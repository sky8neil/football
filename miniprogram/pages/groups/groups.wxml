<view class="page">
  <view class="page-header">
    <view class="page-title">{{title}}</view>
    <view class="page-subtitle">{{subtitleText}}</view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'error'}}" class="error">
    <view>{{errorMessage}}</view>
    <button bindtap="onRetry">{{retryText}}</button>
  </view>
  <view wx:elif="{{state === 'ready'}}">
    <view wx:if="{{groups.length === 0}}" class="empty-hero">
      <view class="group-mark">{{groupMarkText}}</view>
      <view class="hero-title">{{emptyText}}</view>
      <view class="hero-copy">
        <view>{{descriptionText}}</view>
      </view>
    </view>
    <view wx:if="{{groups.length > 0}}" class="group-list">
      <view wx:for="{{groups}}" wx:key="group_id" class="group-row" data-group-id="{{item.group_id}}" bindtap="onGroupTap">
        <view class="group-copy">
          <view class="group-name">{{item.display_name}}</view>
          <view class="group-meta">{{item.memberCountText}} · {{item.roleText}}</view>
        </view>
        <view class="group-arrow">›</view>
      </view>
    </view>

    <view class="actions">
      <button wx:if="{{canCreate}}" class="action-card" bindtap="onCreateTap" loading="{{loadingAction}}">
        <view class="action-mark create-mark">+</view>
        <view class="action-copy">
          <view class="action-title">{{createText}}</view>
          <view class="action-subtitle">{{createHintText}}</view>
        </view>
        <view class="action-arrow">›</view>
      </button>
      <button wx:if="{{canJoin}}" class="action-card" bindtap="onJoinTap">
        <view class="action-mark join-mark">{{codeMarkText}}</view>
        <view class="action-copy">
          <view class="action-title">{{joinText}}</view>
          <view class="action-subtitle">{{joinHintText}}</view>
        </view>
        <view class="action-arrow">›</view>
      </button>
    </view>

    <view class="group-rules">
      <view wx:for="{{rules}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <view class="group-limits">{{usageText}}</view>
  </view>
</view>
