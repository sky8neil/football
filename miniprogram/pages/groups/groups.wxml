<view class="page">
  <view class="page-title">{{title}}</view>
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'error'}}" class="error">
    <view>{{errorMessage}}</view>
    <button bindtap="onRetry">{{retryText}}</button>
  </view>
  <view wx:elif="{{state === 'ready'}}">
    <view class="ui-placeholder">
      <view>{{description}}</view>
      <view>{{limitsText}}</view>
    </view>
    <view wx:if="{{groups.length === 0}}" class="ui-placeholder">{{emptyText}}</view>
    <view wx:for="{{groups}}" wx:key="group_id" class="group-row" data-group-id="{{item.group_id}}" bindtap="onGroupTap">
      <view>{{item.display_name}}</view>
      <view>{{item.memberCountText}} · {{item.roleText}}</view>
    </view>
    <button wx:if="{{canCreate}}" bindtap="onCreateTap" loading="{{loadingAction}}">{{createText}}</button>
    <view wx:if="{{canJoin}}" class="join-row">
      <input value="{{inviteCode}}" maxlength="8" placeholder="{{inviteCodePlaceholder}}" bindinput="onInviteInput" />
      <button bindtap="onJoinTap">{{joinText}}</button>
    </view>
  </view>
</view>
