<view class="page">
  <view class="page-header">
    <view class="page-title">{{title}}</view>
    <view wx:if="{{subtitle}}" class="page-subtitle">{{subtitle}}</view>
  </view>
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'error'}}" class="error">
    <view>{{errorMessage}}</view>
    <button bindtap="onRetry">{{retryText}}</button>
  </view>
  <view wx:elif="{{state === 'ready'}}">
    <view class="group-summary">
      <view wx:if="{{isCreationSuccess}}" class="success-mark">✓</view>
      <view class="group-name">{{group.display_name}}</view>
      <view class="group-role">{{group.role === 'owner' ? ownerText : memberText}} · {{group.memberCountText}}</view>
      <view class="invite-label">{{inviteCodeLabel}}</view>
      <view class="invite-code">{{group.formattedInviteCode}}</view>
      <view wx:if="{{isCreationSuccess}}" class="share-hint">{{inviteHintText}}</view>
      <view class="share-actions">
        <button class="share-button" open-type="share">{{shareText}}</button>
        <button class="copy-button" bindtap="onCopyInviteTap">{{copyText}}</button>
      </view>
    </view>
    <view class="group-facts">
      <view class="fact-row"><text>{{membersLabel}}</text><text>{{group.memberCapacityText}}</text></view>
      <view class="fact-row"><text>{{rankingLabel}}</text><text>{{rankingHintText}}</text></view>
      <view wx:if="{{isCreationSuccess}}" class="fact-row"><text>{{ownedLabel}}</text><text>{{ownedCountText}}</text></view>
    </view>
    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <view class="management-actions">
      <button wx:if="{{group.role === 'member'}}" class="manage-button" bindtap="onLeaveTap" loading="{{loadingAction}}">{{leaveText}}</button>
      <button wx:if="{{group.role === 'owner'}}" class="manage-button danger" bindtap="onDissolveTap" loading="{{loadingAction}}">{{dissolveText}}</button>
    </view>
  </view>
</view>
