.page {
  min-height: 100vh;
  padding: var(--space-8) var(--page-padding-inline) var(--page-padding-bottom);
  color: var(--text-primary);
  background: var(--surface-page);
}

.page-header { margin-bottom: var(--space-8); }
.page-title { font-size: var(--font-36); font-weight: var(--weight-bold); }
.page-subtitle { margin-top: var(--space-2); color: var(--text-secondary); font-size: var(--font-22); }

.group-summary,
.group-facts {
  border: var(--border-hairline) solid var(--border-glass-strong);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: var(--shadow-bug);
}

.group-summary {
  padding: var(--space-8) var(--space-6);
  text-align: center;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--mark-size);
  height: var(--mark-size);
  margin: 0 auto var(--space-5);
  border-radius: 50%;
  background: var(--teal-50);
  color: var(--teal-700);
  font-size: var(--font-36);
  font-weight: var(--weight-bold);
}

.group-name { font-size: var(--font-30); font-weight: var(--weight-bold); }
.group-role { margin-top: var(--space-2); color: var(--text-secondary); font-size: var(--font-22); }
.invite-label { margin-top: var(--space-8); color: var(--text-secondary); font-size: var(--font-22); }
.invite-code { margin-top: var(--space-3); color: var(--green-900); font-size: var(--font-36); font-weight: var(--weight-bold); }
.share-hint { margin-top: var(--space-3); color: var(--text-secondary); font-size: var(--font-20); }

.share-actions { display: flex; gap: var(--space-3); margin-top: var(--space-6); }
.share-button,
.copy-button,
.manage-button {
  width: auto;
  min-height: var(--cta-height);
  min-width: 0;
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-md);
  font-size: var(--font-22);
  line-height: var(--cta-height);
}
.share-button { background: var(--cta-background); color: var(--text-on-brand); font-weight: var(--weight-semibold); }
.copy-button { background: var(--surface-ghost); color: var(--text-primary); }
.share-button::after,
.copy-button::after,
.manage-button::after { border: 0; }

.group-facts { margin-top: var(--space-5); padding: 0 var(--space-6); }
.fact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  min-height: var(--ghost-button-height);
  border-bottom: var(--border-hairline) solid var(--border-subtle);
  font-size: var(--font-22);
}
.fact-row:last-child { border-bottom: 0; }
.fact-row text:first-child { color: var(--text-secondary); }
.fact-row text:last-child { text-align: right; }

.management-actions { margin-top: var(--space-5); }
.manage-button { width: 100%; background: var(--surface-ghost); color: var(--text-primary); }
.manage-button.danger { color: var(--text-danger); }
.inline-error { margin-top: var(--space-4); color: var(--text-danger); font-size: var(--font-22); text-align: center; }
.loading,
.error {
  min-height: var(--ghost-button-height);
  padding: var(--space-6);
  color: var(--text-danger);
}
.management-actions button + button {
  margin-top: var(--space-3);
}

.group-summary button,
.management-actions button {
  text-align: center;
}

.group-summary button::after,
.management-actions button::after {
  border: 0;
}
