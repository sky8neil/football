<view class="page">
  <view class="page-header">
    <view class="page-title">{{title}}</view>
    <view class="page-subtitle">{{subtitle}}</view>
  </view>
  <view wx:if="{{state === 'ready'}}" class="code-panel">
    <view class="panel-title">{{inviteCodeLabel}}</view>
    <view class="panel-copy">{{inviteFormatText}}</view>
    <view class="code-entry">
      <view class="code-cells">
        <view wx:for="{{inviteCells}}" wx:key="index" class="code-cell {{item.active ? 'active' : ''}}">{{item.value}}</view>
      </view>
      <input class="code-input" type="text" maxlength="8" value="{{inviteCode}}" bindinput="onInviteInput" />
    </view>
    <view class="remaining">{{remainingText}}</view>
    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <button class="join-button" bindtap="onConfirm" loading="{{loading}}" disabled="{{!canConfirm || loading}}">{{confirmText}}</button>
  </view>
  <view wx:if="{{state === 'error'}}" class="error-panel">
    <view>{{errorMessage}}</view>
  </view>
</view>
