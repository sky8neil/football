<view class="page">
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'error'}}" class="error-state">
    <text>{{errorMessage}}</text>
    <button bindtap="loadDetail">重试</button>
  </view>
  <view wx:else class="detail">
    <view class="match-head">
      <view class="match-meta">
        <text>{{statusText}}</text>
        <text wx:if="{{match.round_id}}">{{match.round_id}}</text>
        <text>{{kickoffText}}</text>
      </view>
      <view class="scoreline">
        <view class="team">
          <image src="{{homeLogo}}" mode="aspectFit"></image>
          <text>{{match.home_team.name}}</text>
        </view>
        <view class="score">
          <text wx:if="{{match.regular_home_score !== null && match.regular_home_score !== undefined}}">{{match.regular_home_score}} : {{match.regular_away_score}}</text>
          <text wx:else>VS</text>
          <text class="score-caption">{{match.match_status === 'live' ? '进行中' : match.match_status === 'finished' ? '全场比分' : '开球时间'}}</text>
        </view>
        <view class="team away">
          <image src="{{awayLogo}}" mode="aspectFit"></image>
          <text>{{match.away_team.name}}</text>
        </view>
      </view>
      <view wx:if="{{match.prediction_deadline_at && canSubmit}}" class="deadline">
        预测截止 {{match.prediction_deadline_at}}
      </view>
    </view>

    <view wx:if="{{myPrediction}}" class="prediction-result">
      <view class="section-title">我的预测</view>
      <view class="prediction-line">
        <text class="prediction-score">{{myPredictionScore}}</text>
        <text>{{myPrediction.derived_result === 'HOME' ? '主胜' : myPrediction.derived_result === 'AWAY' ? '客胜' : '平局'}}</text>
      </view>
      <view class="result-line">
        <text>{{predictionResultText}}</text>
        <text>{{predictionPointsText}}</text>
      </view>
      <view wx:if="{{myPrediction.submitted_at}}" class="submitted-at">提交于 {{myPrediction.submitted_at}}</view>
    </view>

    <view wx:if="{{canSubmit}}" class="prediction-form">
      <view class="section-title">预测比分</view>
      <view class="steppers">
        <view class="stepper-group">
          <view class="stepper-team"><image src="{{homeLogo}}" mode="aspectFit"></image><text>{{match.home_team.name}}</text></view>
          <view class="stepper">
            <button data-side="home" data-delta="-1" bindtap="onScoreStep">−</button>
            <text>{{homeScore}}</text>
            <button data-side="home" data-delta="1" bindtap="onScoreStep">+</button>
          </view>
        </view>
        <text class="separator">:</text>
        <view class="stepper-group">
          <view class="stepper-team"><image src="{{awayLogo}}" mode="aspectFit"></image><text>{{match.away_team.name}}</text></view>
          <view class="stepper">
            <button data-side="away" data-delta="-1" bindtap="onScoreStep">−</button>
            <text>{{awayScore}}</text>
            <button data-side="away" data-delta="1" bindtap="onScoreStep">+</button>
          </view>
        </view>
      </view>
      <view class="derived">即时判定：{{derivedResultText}}</view>
      <view class="scoring-note">赛果命中 +3 分 · 精确比分 +12 分</view>
      <button class="submit" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">
        {{submitting ? '提交中…' : '提交预测'}}
      </button>
      <view class="submit-note">提交后无法修改</view>
    </view>

    <view wx:if="{{identityMissing}}" class="status-panel">
      <text>{{submitDisabledReason}}</text>
      <button bindtap="onSessionTap">登录</button>
    </view>
    <view wx:elif="{{userDeleted || (!canSubmit && submitDisabledReason)}}" class="status-panel">
      <text>{{submitDisabledReason}}</text>
    </view>
    <view wx:if="{{formError}}" class="error-message">{{formError}}</view>

    <view wx:if="{{crowdKind !== 'hidden' && crowdState !== 'idle'}}" class="crowd-card">
      <view class="section-title">{{crowdTitle}}</view>
      <view wx:if="{{crowdState === 'loading'}}" class="crowd-message">{{crowdLoadingText}}</view>
      <view wx:elif="{{crowdKind === 'guest'}}" class="crowd-message crowd-action"><text>{{crowdMessage}}</text><button bindtap="onSessionTap">{{crowdLoginText}}</button></view>
      <view wx:elif="{{crowdKind === 'locked' || crowdKind === 'insufficient'}}" class="crowd-message">{{crowdMessage}}</view>
      <view wx:elif="{{crowdState === 'error'}}" class="crowd-message crowd-action"><text>{{crowdMessage}}</text><button bindtap="onCrowdRetry">{{crowdRetryText}}</button></view>
      <view wx:elif="{{crowdKind === 'available'}}">
        <view class="crowd-legend">
          <view wx:for="{{crowdSegments}}" wx:key="key" class="crowd-item {{item.selected ? 'selected' : ''}} {{item.actual ? 'actual' : ''}}">
            <view class="crowd-item-name"><text>{{item.name}}</text><text wx:if="{{item.selected}}" class="crowd-tag">{{crowdYourChoice}}</text><text wx:if="{{item.actual}}" class="crowd-tag actual-tag">{{crowdActualLabel}}</text></view>
            <text class="crowd-percent">{{item.percent}}%</text>
          </view>
        </view>
        <view class="crowd-bar"><view wx:for="{{crowdSegments}}" wx:key="key" class="crowd-segment crowd-{{item.key}} {{item.selected ? 'selected' : ''}} {{item.actual ? 'actual' : ''}}" style="width: {{item.width}}"></view></view>
        <view wx:if="{{crowdComparisonText}}" class="crowd-comparison">{{crowdComparisonText}}</view>
        <view class="crowd-footer">{{crowdFooter}}</view>
      </view>
    </view>
  </view>
</view>
