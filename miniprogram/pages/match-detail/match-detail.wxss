@import "../../styles/secondary-pages.wxss";

.page {
  padding: 24rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.num {
  font-variant-numeric: tabular-nums;
}

.detail {
  display: flex;
  flex-direction: column;
}

.glass-card.strong {
  background: rgba(255, 255, 255, 0.78);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 状态标签 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.chip-brand {
  background: var(--color-brand-soft);
  color: var(--color-brand-primary-pressed);
}

.chip-live {
  background: var(--color-state-live-soft);
  color: var(--color-state-live);
}

.chip-done {
  background: var(--color-state-done-soft);
  color: var(--text-secondary);
}

.chip-hit {
  background: var(--color-state-hit-soft);
  color: var(--color-state-locked);
}

/* 顶部对阵卡 */
.match-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.match-meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.league-mini {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.faceoff {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20rpx;
}

.team-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
  min-width: 0;
}

.team-crest {
  width: 92rpx;
  height: 92rpx;
  flex: none;
}

.team-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.25;
}

.team-role {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 比分块：严格遵守 Design System V1 §6.4，实色不玻璃化 */
.score-bug {
  width: 156rpx;
  min-height: 128rpx;
  padding: 16rpx 12rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-solid);
  border: 2rpx solid var(--border-subtle);
  box-shadow: var(--shadow-bug);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.score-bug.dark {
  background: var(--surface-solid-dark);
  border-color: var(--navy-900);
  color: #ffffff;
}

.bug-main {
  font-size: 40rpx;
  font-weight: 750;
  line-height: 1;
  color: var(--text-primary);
}

.score-bug.dark .bug-main {
  color: #ffffff;
}

.bug-sub {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.score-bug.dark .bug-sub {
  color: rgba(255, 255, 255, 0.78);
}

.deadline-bar {
  margin-top: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-xs);
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 分享卡预填提示条 */
.prefill-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-brand-soft);
  border: 2rpx solid rgba(47, 138, 58, 0.28);
  font-size: 24rpx;
  color: var(--text-positive);
  font-weight: 600;
}

.prefill-icon {
  flex: none;
}

.prefill-text {
  line-height: 1.45;
}

/* 卡片标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

/* 预测表单卡 */
.steppers {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.56);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
}

.stepper-group {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.stepper-team {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  font-size: 24rpx;
  font-weight: 650;
  color: var(--text-primary);
}

.stepper-team-logo {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}

.stepper-team-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stepper-ctrl {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-xs);
  border: 0;
  background: var(--color-brand-soft);
  color: var(--color-brand-primary-pressed);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.step-btn::after {
  border: 0;
}

.step-val {
  width: 48rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.stepper-sep {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-muted);
  margin-top: 44rpx;
}

.derived-row {
  margin: 24rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-positive);
}

.scoring-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 28rpx;
}

.submit-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 我的预测结果卡 */
.my-pred-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.65);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}

.my-pred-score {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
}

.my-pred-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.my-pred-right {
  text-align: right;
}

.my-pred-points {
  font-size: 30rpx;
  font-weight: 750;
  color: var(--text-positive);
}

.my-pred-result {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.submitted-at {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 700;
}

.btn::after {
  border: 0;
}

.btn-block {
  width: 100%;
}

.btn-primary {
  height: 80rpx;
  padding: 0 36rpx;
  background: var(--cta-background);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-floating);
}

.btn-ghost {
  height: 72rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid var(--border-glass-strong);
  color: var(--text-primary);
  font-weight: 600;
  font-size: 26rpx;
}

/* 状态与错误提示 */
.status-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--text-secondary);
}

.status-text {
  font-size: 24rpx;
}

.status-action {
  flex: none;
}

.error-message {
  margin: 0 8rpx 20rpx;
  color: var(--text-danger);
  font-size: 24rpx;
}

.error-state {
  text-align: center;
}

.error-text {
  color: var(--text-danger);
  font-size: 26rpx;
}

/* 大家怎么选 */
.crowd-message {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.crowd-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.crowd-btn {
  flex: none;
}

.crowd-legend {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.crowd-item {
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.56);
  border: 2rpx solid transparent;
}

.crowd-item.selected {
  background: var(--color-brand-soft);
  border-color: rgba(47, 138, 58, 0.32);
}

.crowd-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.crowd-pct {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.crowd-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 99rpx;
  background: var(--color-brand-primary-pressed);
  color: #ffffff;
}

.actual-tag {
  background: var(--teal-700);
}

.crowd-bar {
  display: flex;
  height: 20rpx;
  border-radius: 99rpx;
  overflow: hidden;
  gap: 4rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.5);
}

.crowd-segment {
  height: 100%;
}

.crowd-home {
  background: #3aa37a;
}

.crowd-draw {
  background: #94a3b8;
}

.crowd-away {
  background: #f08a3c;
}

.crowd-comparison {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.crowd-footer {
  font-size: 22rpx;
  color: var(--text-muted);
}

.loading {
  min-height: 200rpx;
}
