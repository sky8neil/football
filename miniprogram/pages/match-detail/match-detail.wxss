.page {
  min-height: 100vh;
  padding: var(--space-8) var(--page-padding-inline) var(--page-padding-bottom);
  color: var(--text-primary);
  background: var(--surface-page);
}

.detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.match-head,
.prediction-result,
.prediction-form,
.status-panel,
.crowd-card {
  padding: var(--space-8);
  border: var(--border-hairline) solid var(--border-glass-strong);
  border-radius: var(--radius-card);
  background: var(--surface-card-strong);
  box-shadow: var(--shadow-card);
}

.match-meta,
.result-line,
.prediction-line,
.steppers {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-meta {
  color: var(--text-secondary);
  font-size: var(--font-24);
}

.scoreline {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-8) 0;
}

.team {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  text-align: center;
  font-size: var(--font-26);
  font-weight: var(--weight-semibold);
}

.team image,
.stepper-team image {
  width: 104rpx;
  height: 104rpx;
  flex: none;
}

.score {
  min-width: 176rpx;
  text-align: center;
  font-size: var(--font-36);
  font-weight: var(--weight-heavy);
  font-family: var(--font-family-number);
}

.score-caption,
.deadline,
.submitted-at,
.submit-note {
  display: block;
  margin-top: var(--space-3);
  color: var(--text-muted);
  font-size: var(--font-22);
  font-weight: var(--weight-regular);
}

.section-title {
  margin-bottom: var(--space-6);
  font-size: var(--font-30);
  font-weight: var(--weight-bold);
}

.prediction-line {
  justify-content: flex-start;
  gap: var(--space-6);
  font-size: var(--font-26);
}

.prediction-score {
  font-size: var(--font-36);
  font-weight: var(--weight-heavy);
  font-family: var(--font-family-number);
}

.result-line {
  margin-top: var(--space-5);
  padding-top: var(--space-5);
  border-top: var(--border-hairline) solid var(--border-subtle);
  color: var(--text-positive);
}

.steppers {
  gap: var(--space-4);
}

.stepper-group {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}

.stepper-team {
  display: flex;
  max-width: 100%;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-22);
}

.stepper-team image {
  width: 44rpx;
  height: 44rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.stepper button {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: var(--radius-xs);
  color: var(--text-primary);
  background: var(--surface-ghost);
  font-size: var(--font-36);
  line-height: 72rpx;
}

.stepper text {
  width: 64rpx;
  text-align: center;
  font-size: var(--font-36);
  font-weight: var(--weight-bold);
  font-family: var(--font-family-number);
}

.separator {
  align-self: flex-end;
  padding-bottom: var(--space-5);
  font-size: var(--font-30);
}

.derived,
.scoring-note,
.submit-note {
  text-align: center;
}

.derived {
  margin-top: var(--space-6);
  font-size: var(--font-26);
}

.scoring-note {
  margin-top: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--font-22);
}

.submit {
  margin-top: var(--space-6);
  border-radius: var(--radius-md);
  color: var(--text-on-brand);
  background: var(--cta-background);
  font-size: var(--font-30);
  font-weight: var(--weight-bold);
}

.submit-note {
  margin-top: var(--space-3);
}

.status-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  color: var(--text-secondary);
}

.status-panel button,
.error-state button {
  flex: none;
  color: var(--text-primary);
  background: var(--surface-ghost);
}

.error-message,
.error-state {
  color: var(--text-danger);
}

.crowd-message { color: var(--text-secondary); font-size: var(--font-24); }
.crowd-action { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
.crowd-action button { flex: none; color: var(--text-primary); background: var(--surface-ghost); }
.crowd-legend { display: flex; justify-content: space-between; gap: var(--space-3); }
.crowd-item { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: var(--space-2); color: var(--text-secondary); font-size: var(--font-22); }
.crowd-item-name { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); }
.crowd-tag { color: var(--color-brand-primary-pressed); font-size: var(--font-18); }
.actual-tag { color: var(--teal-700); }
.crowd-percent { color: var(--text-primary); font-family: var(--font-family-number); font-size: var(--font-28); font-weight: var(--weight-bold); }
.crowd-bar { display: flex; height: 24rpx; overflow: hidden; margin-top: var(--space-4); border-radius: var(--radius-pill); background: var(--surface-ghost); }
.crowd-segment { height: 100%; }
.crowd-home { background: var(--color-brand-primary); }
.crowd-draw { background: var(--color-state-done); }
.crowd-away { background: var(--teal-700); }
.crowd-segment.selected { box-shadow: inset 0 0 0 3rpx var(--text-primary); }
.crowd-segment.actual { box-shadow: inset 0 0 0 4rpx var(--white); }
.crowd-comparison { margin-top: var(--space-5); color: var(--text-primary); font-size: var(--font-24); font-weight: var(--weight-semibold); }
.crowd-footer { margin-top: var(--space-4); color: var(--text-muted); font-size: var(--font-20); }

.loading,
.error-state {
  min-height: 160rpx;
  padding: var(--space-8);
}

.error-state button {
  margin-top: var(--space-5);
}
