@import "../../styles/baseline-v041.wxss";
.settings-page { min-height:100vh;background:#d5ead4;color:#1f3226;font-size:14px; }
.pitch { position:fixed;top:0;left:0;width:100%;height:100vh;opacity:.32; }
.content { position:relative;padding:24px 16px 40px; }
.title { font-size:24px;font-weight:700; }.subtitle { color:#52665b;font-size:12px;margin:8px 0 24px; }
.card { padding:18px;margin-bottom:14px;background:rgba(255,255,255,.76);border:1px solid rgba(255,255,255,.8);border-radius:18px;backdrop-filter:blur(12px); }
.label { display:block;font-weight:700; }.card input { margin-top:12px;padding:12px;background:rgba(255,255,255,.8);border-radius:10px;font-size:15px; }
button { padding:0;margin:0;background:transparent;font-size:14px;line-height:1.5;border-radius:0; }button::after { border:0; }
.team-toggle { display:flex;align-items:center;justify-content:space-between;text-align:left;gap:12px; }.team-toggle>text:last-child { color:#52665b; }
.team-row { display:flex;align-items:center;gap:12px;padding:14px 8px;text-align:left;border-bottom:1px solid rgba(31,77,54,.08); }.team-row image { width:28px;height:28px;flex:none; }.team-name { flex:1; }.selected { color:#2f8a3a;font-weight:700;background:rgba(47,138,58,.07);border-radius:10px; }
.hint { display:block;font-size:12px;color:#52665b;margin-top:14px; }.more { color:#2f8a3a;padding:14px; }.save { background:linear-gradient(135deg,#1f4d36,#0e2d20);color:white;font-weight:700;border-radius:14px;padding:15px; }.save[disabled] { opacity:.6;color:white; }

.save-error { margin:12px 0;padding:12px 14px;background:#fff0ec;color:#9b392c;border-radius:10px;font-size:13px;line-height:1.6; }
