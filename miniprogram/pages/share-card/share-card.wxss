@import "../../styles/secondary-pages.wxss";

.page {
  padding: 24rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.num {
  font-variant-numeric: tabular-nums;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  margin: 0;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-primary);
}

/* 顶部独立深绿海报卡 */
.poster-top {
  background: var(--secondary-dark);
  color: #ffffff;
  padding: 36rpx 32rpx 32rpx;
  border-radius: var(--radius-card);
  border: 2rpx solid var(--secondary-dark-border);
  box-shadow: var(--secondary-dark-shadow);
  margin-bottom: 28rpx;
}

.poster-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.poster-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--secondary-accent);
  letter-spacing: 0.04em;
}

.poster-round-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.poster-user {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.poster-user-info {
  min-width: 0;
}

.poster-name {
  font-size: 40rpx;
  font-weight: 750;
  letter-spacing: -0.01em;
  color: #ffffff;
}

.poster-team {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.poster-deleted-note {
  color: rgba(255, 255, 255, 0.65);
}

.poster-team-logo {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.poster-score-hero {
  margin: 32rpx 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(185, 240, 143, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.big-score {
  display: flex;
  flex-direction: column;
}

.big-score-num {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--secondary-accent);
}

.big-score-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.mini-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  text-align: center;
}

.mini-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mini-stat-val {
  display: block;
  font-size: 34rpx;
  font-weight: 750;
  color: #ffffff;
  line-height: 1.1;
}

.mini-stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.poster-identity-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.identity-metric {
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
}

.identity-metric-strong {
  font-weight: 700;
  color: #ffffff;
}

/* 单场预测明细区：与首页 matches 完全一致的雾白半透明玻璃效果 */
.poster-body {
  padding: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.match-row {
  position: relative;
  padding: 24rpx 24rpx 24rpx 30rpx;
  border-radius: var(--radius-card);
  background: rgba(255, 255, 255, 0.54);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 24rpx 60rpx rgba(23, 60, 35, 0.10), inset 0 2rpx 0 rgba(255, 255, 255, 0.60);
  backdrop-filter: blur(36rpx);
  -webkit-backdrop-filter: blur(36rpx);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.match-row.is-open {
  background: rgba(255, 255, 255, 0.58);
}

.match-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 99rpx;
  background: var(--color-state-done);
}

.match-row.is-open::before {
  background: var(--color-brand-primary);
}

.match-row.is-live::before {
  background: var(--color-state-live);
}

.match-row.is-hit::before {
  background: var(--color-state-success);
}

.empty-matches {
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 36rpx 24rpx;
}

.empty-matches::before {
  display: none;
}

.match-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.match-kickoff {
  font-size: 22rpx;
  color: var(--text-muted);
}

.match-teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.m-team {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.m-team.away {
  justify-content: flex-end;
  text-align: right;
}

.m-team-logo {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.m-team-name {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-vs {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
}

.match-row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(22, 48, 36, 0.06);
}

.score-pair {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.pred-badge {
  font-weight: 700;
  color: var(--text-primary);
}

.actual-badge {
  color: var(--text-secondary);
}

.follow-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--radius-xs);
  background: var(--cta-background);
  color: var(--text-on-brand);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.follow-btn::after {
  border: 0;
}

/* 状态标签 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.chip-brand {
  background: var(--color-brand-soft);
  color: var(--color-brand-primary-pressed);
}

.chip-live {
  background: var(--color-state-live-soft);
  color: var(--color-state-live);
}

.chip-done {
  background: var(--color-state-done-soft);
  color: var(--text-secondary);
}

.chip-hit {
  background: var(--color-state-hit-soft);
  color: var(--color-state-locked);
}

/* 底部操作区 */
.poster-foot {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.generated-time {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  border: 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 700;
}

.btn::after {
  border: 0;
}

.btn-block {
  width: 100%;
}

.btn-primary {
  height: 80rpx;
  padding: 0 36rpx;
  background: var(--cta-background);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-floating);
}

.btn-ghost {
  height: 72rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid var(--border-glass-strong);
  color: var(--text-primary);
  font-weight: 600;
  font-size: 26rpx;
}

/* 状态卡 */
.glass-card.strong {
  background: rgba(255, 255, 255, 0.78);
}

.state-panel {
  text-align: center;
  padding: 64rpx 40rpx;
  min-height: 220rpx;
}

.state-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: var(--color-brand-soft);
  color: var(--text-positive);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}

.state-icon-live {
  background: var(--color-state-live-soft);
  color: var(--color-state-live);
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 24rpx;
}

.state-btn {
  min-width: 256rpx;
}
