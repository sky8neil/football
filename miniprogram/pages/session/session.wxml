<view class="session-page">
  <image class="pitch" src="/assets/images/baseline-pitch.webp" mode="aspectFill" />
  <view class="content">
    <view class="mark">
      <image class="mark-ball" src="/assets/icons/icon-ball.png" mode="aspectFit" />
    </view>
    <view class="title">先给自己取个名字</view>
    <view class="subtitle">首页会用它问候你，也会出现在排行榜和群榜上。</view>

    <view class="card">
      <view class="field {{overflow ? 'is-over' : ''}}">
        <input
          class="nickname-input"
          type="nickname"
          value="{{nickname}}"
          maxlength="32"
          placeholder="点这里用微信昵称，或自己起一个"
          placeholder-class="nickname-placeholder"
          disabled="{{loading}}"
          confirm-type="done"
          aria-label="昵称"
          bindinput="onNicknameInput"
          bindblur="onNicknameInput"
          bindconfirm="onSubmit"
        />
        <view
          wx:if="{{nickname && !loading}}"
          class="clear"
          aria-role="button"
          aria-label="清空昵称"
          bindtap="onClear"
        >×</view>
      </view>

      <view class="meta">
        <text class="hint">{{privacyRejected ? "未授权微信昵称，手动输入也可以" : "之后可在「我的 · 个人资料设置」修改"}}</text>
        <text wx:if="{{lengthText}}" class="counter {{overflow ? 'is-over' : ''}}">{{lengthText}}</text>
      </view>

      <view wx:if="{{errorMessage}}" class="error">{{errorMessage}}</view>

      <button
        class="cta"
        hover-class="cta-hover"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onSubmit"
      >{{loading ? "正在进入…" : "开始预测"}}</button>
    </view>

    <button wx:if="{{canRetry}}" class="ghost" bindtap="onRetry" disabled="{{loading}}">重试</button>
    <button wx:if="{{canSkip}}" class="ghost" bindtap="onSkip">先随便逛逛</button>
  </view>

  <!--
    隐私授权卡：必须由我们自己弹。
    <input type="nickname"> 在未同意时不会触发 onNeedPrivacyAuthorization，
    而是静默降级为普通文本框，用户根本看不到授权入口。
    「同意」按钮必须用 open-type="agreePrivacyAuthorization"，
    微信靠这个按钮完成同意同步，不能用普通 bindtap 代替。
  -->
  <view wx:if="{{showPrivacy}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-card">
      <view class="privacy-title">隐私保护提示</view>
      <view class="privacy-body">
        为了在首页问候语、排行榜和群榜里显示你的称呼，我们需要读取你在微信的昵称。昵称只用于展示，不会用于其他用途。
      </view>
      <view class="privacy-contract" bindtap="onOpenPrivacyContract">
        查看{{privacyContractName}}
      </view>
      <button
        id="privacy-agree-btn"
        class="privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacy"
      >同意并继续</button>
      <button class="privacy-reject" bindtap="onRejectPrivacy">不同意</button>
    </view>
  </view>
</view>
