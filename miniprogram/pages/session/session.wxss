@import "../../styles/baseline-v041.wxss";

.session-page {
  position: relative;
  min-height: 100vh;
  background: var(--green-100);
  color: var(--text-primary);
  font-size: 14px;
}

/* 与「个人资料设置」同源：球场图降透明铺底，内容层抬 z-index。 */
.pitch {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  opacity: .32;
}

.content {
  position: relative;
  z-index: 1;
  padding: calc(env(safe-area-inset-top) + 72px) 20px calc(env(safe-area-inset-bottom) + 40px);
}

.mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--mark-size);
  height: var(--mark-size);
  margin-bottom: 18px;
  border-radius: var(--mark-radius);
  background: var(--mark-gradient);
  box-shadow: var(--shadow-mark);
}

.mark-ball {
  width: var(--mark-ball-size);
  height: var(--mark-ball-size);
}

.title {
  font-size: 24px;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin: 8px 0 24px;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.6;
}

.card {
  padding: 18px;
  border: 1px solid var(--border-glass-strong);
  border-radius: 18px;
  background: var(--surface-card-strong);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(12px);
}

.field {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 48px;
  padding: 0 12px;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  background: rgba(255, 255, 255, .86);
}

.field.is-over {
  border-color: var(--text-danger);
}

.nickname-input {
  flex: 1;
  min-width: 0;
  height: 48px;
  font-size: 16px;
  color: var(--text-primary);
}

.nickname-placeholder {
  color: var(--text-muted);
  font-size: 14px;
}

.clear {
  flex: none;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(22, 48, 36, .08);
  color: var(--text-secondary);
  font-size: 16px;
  line-height: 22px;
  text-align: center;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 10px 2px 16px;
}

.hint {
  flex: 1;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.5;
}

.counter {
  flex: none;
  color: var(--text-muted);
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}

.counter.is-over {
  color: var(--text-danger);
}

.error {
  margin-bottom: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(192, 86, 33, .08);
  color: var(--text-danger);
  font-size: 13px;
  line-height: 1.6;
}

/* button 默认样式重置（本页所有按钮都是自定义外观） */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  font-size: 14px;
  line-height: 1.5;
  border-radius: 0;
}

button::after {
  border: 0;
}

.cta {
  height: 48px;
  border-radius: 14px;
  background: var(--surface-solid-dark);
  color: var(--white);
  font-size: 16px;
  font-weight: 700;
  line-height: 48px;
  box-shadow: var(--shadow-floating);
}

.cta-hover {
  opacity: .88;
}

.cta[disabled] {
  opacity: .6;
  color: var(--white);
}

.ghost {
  margin-top: 14px;
  height: 40px;
  border-radius: 12px;
  background: var(--surface-ghost);
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 40px;
}

.ghost[disabled] {
  opacity: .6;
}

/* ---- 隐私授权卡 ---- */
.privacy-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28px;
  background: rgba(11, 26, 19, .46);
}

.privacy-card {
  width: 100%;
  padding: 22px 20px 16px;
  border-radius: 18px;
  background: var(--surface-solid-light, #ffffff);
  box-shadow: var(--shadow-floating);
}

.privacy-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
}

.privacy-body {
  margin: 12px 0 10px;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.7;
}

.privacy-contract {
  display: inline-block;
  margin-bottom: 18px;
  color: var(--green-600, #1f7a4d);
  font-size: 13px;
  text-decoration: underline;
}

.privacy-agree {
  height: 44px;
  border-radius: 12px;
  background: var(--surface-solid-dark);
  color: var(--white);
  font-size: 15px;
  font-weight: 700;
  line-height: 44px;
}

.privacy-reject {
  margin-top: 10px;
  height: 40px;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 40px;
}
