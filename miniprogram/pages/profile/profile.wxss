@import "../../styles/secondary-pages.wxss";
.page {
  min-height: 100vh;
  padding: var(--space-8) var(--page-padding-inline) var(--page-padding-bottom);
  color: var(--text-primary);
  background: var(--surface-page);
}

.profile-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.profile-heading,
.section-heading,
.group-row,
.actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-heading {
  justify-content: flex-start;
  gap: var(--space-5);
}

.avatar {
  display: flex;
  width: var(--secondary-avatar);
  height: var(--secondary-avatar);
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  color: var(--text-primary);
  background: var(--color-brand-soft);
  font-size: var(--font-36);
  font-weight: var(--weight-bold);
}

.identity {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--space-2);
}

.nickname {
  font-size: var(--font-30);
  font-weight: var(--weight-bold);
}

.favorite,
.season-id {
  color: var(--text-secondary);
  font-size: var(--font-22);
}

.recap {
  padding: var(--space-6);
  border-left: var(--border-hairline) solid var(--color-brand-primary);
  border-radius: var(--radius-sm);
  background: var(--surface-card-strong);
  color: var(--text-positive);
}

.stats-section,
.groups-section {
  padding-top: var(--space-5);
  border-top: var(--border-hairline) solid var(--border-subtle);
}

.section-heading {
  margin-bottom: var(--space-4);
}

.section-title {
  font-size: var(--font-26);
  font-weight: var(--weight-bold);
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.stat {
  display: flex;
  min-width: 30%;
  min-height: var(--secondary-avatar);
  flex: 1;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--surface-card-strong);
}

.value {
  font-family: var(--font-family-number);
  font-size: var(--font-30);
  font-weight: var(--weight-bold);
}

.label {
  color: var(--text-muted);
  font-size: var(--font-20);
}

.actions {
  gap: var(--space-4);
}

.actions button {
  width: 50%;
  margin: 0;
  color: var(--text-primary);
  background: var(--surface-ghost);
}

.text-action {
  margin: 0;
  padding: 0;
  color: var(--text-secondary);
  background: transparent;
  font-size: var(--font-22);
}

.empty-groups {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-5) 0;
  color: var(--text-secondary);
  font-size: var(--font-22);
}

.empty-groups .actions {
  width: 100%;
}

.empty-groups button {
  flex: none;
  margin: 0;
  color: var(--text-on-brand);
  background: var(--cta-background);
}

.group-row {
  gap: var(--space-4);
  min-height: var(--secondary-row-height);
  border-bottom: var(--border-hairline) solid var(--border-subtle);
  font-size: var(--font-22);
}

.group-row text:last-child {
  color: var(--text-muted);
}

.state-panel,
.loading {
  min-height: var(--secondary-loading-height);
  padding: var(--space-8);
  color: var(--text-secondary);
  text-align: center;
}

.state-panel button {
  margin-top: var(--space-5);
  color: var(--text-primary);
  background: var(--surface-ghost);
}

.page { background: var(--surface-canvas); }
.profile-heading { gap: var(--secondary-header-gap); }
.avatar { font-size: var(--font-28); }
.nickname { font-size: var(--font-28); }
.stats-section, .groups-section { padding: var(--space-8); border-top: var(--border-hairline) solid var(--border-glass-strong); }
.stats-section.dark-overview { margin-bottom: 0; border-color: var(--secondary-dark-border); }
.section-title { font-size: var(--font-30); }
.stats-grid { margin-top: var(--space-4); }
.stat { background: transparent; min-width: 35%; padding: var(--space-4) 0; }
.value { font-size: var(--font-48); }
.dark-overview .value { color: var(--secondary-accent); }
.dark-overview .label { color: var(--secondary-on-dark); }
.actions button { border: var(--border-hairline) solid var(--border-glass-strong); border-radius: var(--radius-card); background: var(--secondary-glass); font-size: var(--font-26); }
.group-row { font-size: var(--font-26); }
.group-trailing { display: flex; align-items: center; gap: var(--space-4); color: var(--text-muted); font-size: var(--font-22); }
.group-chevron { font-size: var(--font-36); }
.recap { font-size: var(--font-22); border-radius: var(--radius-card); }
