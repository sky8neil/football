.welcome .avatar {width:34px;height:34px;padding:0;border:1px solid var(--white);object-fit:cover}
.welcome-copy .html-b {font-size:12px}
.welcome-copy .html-small {font-size:9px;margin-top:0}
.next-level-panel {margin-top:12px;padding:16px 14px;background:var(--surface-solid-dark);color:var(--white);border-color:var(--border-dark);border-radius:8px}
.next-level-panel .evaluation {color:var(--mint-100)}
.next-level-panel button:focus-visible {outline-color:var(--mint-100)}
.upgrade-heading {display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.upgrade-heading .html-h2 {font-size:15px}
.upgrade-help {width:28px;height:28px;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-size:12px;color:var(--white)}
.upgrade-condition {display:flex;align-items:center;justify-content:space-between;gap:10px;margin:14px 0;font-size:10px}
