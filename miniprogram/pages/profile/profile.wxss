.actual {margin-left:14px}
.result-state {font-size:9px;padding:3px 6px;border-radius:6px;background:var(--color-brand-soft);color:var(--text-positive);white-space:nowrap}
.result-state.wdl {background:var(--color-state-hit-soft);color:var(--color-state-locked)}
