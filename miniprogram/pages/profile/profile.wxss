.upgrade-note {margin-top:12px;font-size:10px;line-height:1.7;color:var(--mint-100)}
.next-level-panel .evaluation {justify-content:flex-start;font-size:9px;margin-top:4px;line-height:1.7}
.next-level-panel .upgrade-condition {margin:0 0 14px;padding-bottom:14px;border-bottom:1px solid rgba(255,255,255,.22)}
.next-level-panel .upgrade-heading {margin:14px 0 0}
.next-level-panel .level-path {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:16px 0;isolation:isolate}
.next-level-panel .level-path:before {left:16.666%;right:16.666%;background:rgba(255,255,255,.3);z-index:0}
.next-level-panel .level-path .html-span {position:relative;z-index:1;color:var(--mint-100)}
.next-level-panel .level-path .current {color:var(--green-300)}
