  font-size: 11px; line-height: 1.6;
}
.page .pill, .page .level, .page .identity .html-h1 .html-span { font-size: 10px; line-height: 1.5; }
.page .text-button { min-height: 36px; }
.page .icon { width: 20px; height: 20px; stroke-width: 1.7; }
