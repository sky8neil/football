page {
  --ui-ink: #163024;
  --ui-secondary: #42564a;
  --ui-muted: #52665b;
  --ui-positive: #1a5c26;
  --ui-selected: #2f8a3a;
  --ui-line: rgba(255,255,255,.88);
  --ui-card: rgba(255,255,255,.68);
  --ui-shadow: 0 8px 24px rgba(23,60,35,.08);
  --ui-font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-family-cn: var(--ui-font);
  --font-family-number: var(--ui-font);
  --text-primary: var(--ui-ink);
  --text-secondary: var(--ui-secondary);
  --text-muted: var(--ui-muted);
  --text-positive: var(--ui-positive);
  --ink: var(--ui-ink);
  --ink-soft: var(--ui-secondary);
  --ink-faint: var(--ui-muted);
  --radius-card: 16px;
  --surface-card: var(--ui-card);
  --surface-card-strong: rgba(255,255,255,.76);
  --shadow-card: var(--ui-shadow);
}
page { background: #e8eee7; }
.page { display: block; margin: 0; padding: 0; background: #e8eee7; font: 13px/1.5 var(--ui-font); color: var(--ui-ink); }
.page view, .page view::before, .page view::after { box-sizing: border-box; letter-spacing: 0; }
button { font-family: var(--ui-font); }
button { -webkit-tap-highlight-color: transparent; }
.page .num, .result .html-b {
  font-family: var(--ui-font); font-variant-numeric: tabular-nums;
}
 .page #app {
  width: min(100%, 390px); max-width: 390px; margin: 0 auto;
  min-height: 100vh; height: auto; border-radius: 0;
  position: relative; isolation: isolate; background: transparent;
  box-shadow: 0 0 32px rgba(23,60,35,.08);
}
.page #app { overflow: clip; padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
.page #app::before, .page #app::after { display: none; }
.page .welcome { margin: 0; padding: 8px 16px 16px; border: 0; display: flex; align-items: center; gap: 9px; }
.page .welcome > button { flex: 0 0 34px; width: 34px; height: 34px; padding: 0; }
.page .welcome .avatar, .page .welcome > image { width: 34px; height: 34px; object-fit: cover; padding: 0; border: 1px solid white; border-radius: 50%; }
.page .welcome-copy { min-width: 0; flex: 1; }
.page .welcome-copy .html-b { display: block; font-size: 14px; line-height: 1.5; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.page .welcome-copy .html-small { display: block; font-size: 11px; line-height: 1.5; color: var(--ui-secondary); margin: 0; }
.page .content { padding-left: 16px; padding-right: 16px; padding-bottom: calc(110px + env(safe-area-inset-bottom,0px)); }
.page .card { border-radius: 16px; border: 1px solid var(--ui-line); box-shadow: var(--ui-shadow); }
.page .card:not(.hero):not(.next-level-panel) { background: var(--ui-card); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
.page .html-h2, .page .upgrade-heading .html-h2 { font-size: 15px; line-height: 1.5; font-weight: 700; }
.page .eyebrow { font-size: 11px; line-height: 1.5; font-weight: 600; color: var(--ui-secondary); }
.page .section-title { margin: 22px 0 10px; }
