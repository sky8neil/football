  border-color: rgba(185,240,143,.22);
  box-shadow: 0 10px 28px rgba(14,45,32,.28), inset 0 1px 0 rgba(255,255,255,.10);
}
.page .next-level-panel .level-path .current { color: var(--deep-accent); }
.page { position: relative; min-height: 100vh; background: var(--surface-canvas); font-size:13px; line-height:1.5; padding:0; }
.page view,.page text,.page button,.page image { box-sizing:border-box; }
button { margin:0; padding:0; line-height:inherit; border-radius:0; background:transparent; }
button::after { border:0; }
