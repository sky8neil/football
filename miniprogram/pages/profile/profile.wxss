.page .text-button .icon, .page .utility .icon:last-child, .page .group-row > .icon { width: 14px; height: 14px; }
 .page .upgrade-help { width: 32px; height: 32px; display: grid; place-items: center; font-size: 14px; flex-shrink: 0; }
 .page .next-level-panel {
  background: linear-gradient(160deg,#1a2b44,#122033); color: #fff;
