.upgrade-integral {display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:10px}
.upgrade-integral .html-b {font-size:10px;font-weight:700;white-space:nowrap}
.next-level-panel .upgrade-heading {margin:0}
.next-level-panel .upgrade-condition {margin:0 0 10px;padding:0;border:0}
