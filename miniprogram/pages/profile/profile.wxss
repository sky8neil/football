.level-path .html-span {text-align:center;font-size:9px;color:var(--text-secondary)}
.level-path .current {color:var(--text-positive);font-weight:600}
dialog .html-h2 {font-size:16px;margin-right:24px}
dialog .html-p+.html-p {margin-top:10px}
@media (max-width:374px){.content {padding-left:10px;padding-right:10px}
.fixture .html-b {font-size:10px}
.actual {margin-left:8px}}
@media (prefers-reduced-motion:reduce){view {scroll-behavior:auto}}
.ring {width:136px;height:136px;margin:0 auto;position:relative;display:grid;place-content:center}
