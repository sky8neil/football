@import "../../styles/secondary-pages.wxss";
.page {
  min-height: 100vh;
  padding: var(--space-8) var(--page-padding-inline) var(--page-padding-bottom);
  color: var(--text-primary);
  background: var(--surface-page);
}

.page-title {
  margin-bottom: var(--space-6);
  font-size: var(--font-36);
  font-weight: var(--weight-bold);
}

.week-group + .week-group {
  margin-top: var(--space-8);
}

.week-heading {
  margin-bottom: var(--space-4);
  color: var(--text-secondary);
  font-size: var(--font-24);
  font-weight: var(--weight-semibold);
}

.prediction-card {
  padding: var(--space-6);
  margin-bottom: var(--space-4);
  border: var(--border-hairline) solid var(--border-glass-strong);
  border-radius: var(--radius-card);
  background: var(--surface-card-strong);
  box-shadow: var(--shadow-sm);
}

.card-head,
.card-foot,
.league,
.match-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.league {
  min-width: 0;
  justify-content: flex-start;
  gap: var(--space-2);
  color: var(--text-secondary);
  font-size: var(--font-22);
}

.league image {
  width: var(--secondary-league-logo);
  height: var(--secondary-league-logo);
  flex: none;
}

.status,
.result {
  color: var(--text-positive);
}

.match-row {
  gap: var(--space-3);
  padding: var(--space-6) 0;
}

.team {
  display: flex;
  width: 31%;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  text-align: center;
  font-size: var(--font-22);
}

.team image {
  width: var(--secondary-crest);
  height: var(--secondary-crest);
  flex: none;
}

.team text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scores {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-family-number);
  font-size: var(--font-30);
  font-weight: var(--weight-bold);
}

.actual,
.card-foot {
  color: var(--text-muted);
  font-size: var(--font-20);
  font-weight: var(--weight-regular);
}

.card-foot {
  padding-top: var(--space-4);
  border-top: var(--border-hairline) solid var(--border-subtle);
}

.result {
  font-size: var(--font-22);
  font-weight: var(--weight-semibold);
}

.more,
.state-panel button,
.empty-state button {
  margin-top: var(--space-5);
  color: var(--text-primary);
  background: var(--surface-ghost);
}

.state-panel,
.empty-state,
.loading {
  min-height: var(--secondary-loading-height);
  padding: var(--space-8);
  text-align: center;
  color: var(--text-secondary);
}

.inline-error {
  margin-top: var(--space-4);
  color: var(--text-danger);
}

.history-end {
  margin-top: var(--space-5);
  color: var(--text-muted);
  font-size: var(--font-22);
  text-align: center;
}

.page { background: var(--surface-canvas); }
.page-title { font-size: var(--font-40); margin-bottom: var(--space-2); }
.week-group { overflow: hidden; padding: var(--space-6); }
.week-heading { font-size: var(--font-26); padding-bottom: var(--space-4); border-bottom: var(--border-hairline) solid var(--border-subtle); }
.prediction-card { padding: var(--space-5) 0; margin: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.prediction-card + .prediction-card { border-top: var(--border-hairline) solid var(--border-subtle); }
.card-head { gap: var(--space-3); }
.status { flex: none; font-size: var(--font-20); background: var(--color-state-done-soft); padding: var(--space-1) var(--space-2); border-radius: var(--radius-xs); }
.match-row { padding: var(--space-4) 0; }
.teams-inline { display: flex; min-width: 0; flex: 1; align-items: center; gap: var(--space-2); }
.team { width: auto; min-width: 0; flex: 1; flex-direction: row; justify-content: flex-start; text-align: left; font-size: var(--font-26); }
.team image { width: var(--secondary-crest); height: var(--secondary-crest); }
.versus { color: var(--text-muted); font-size: var(--font-22); }
.prediction-points { flex: none; font-size: var(--font-36); color: var(--text-positive); font-family: var(--font-family-number); font-weight: var(--weight-bold); }
.prediction-detail { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.scores { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; font-family: var(--font-family-cn); font-size: var(--font-22); font-weight: var(--weight-regular); gap: var(--space-3); }
.actual, .card-foot { font-size: var(--font-22); }
.card-foot { border-top: 0; padding-top: var(--space-2); }
.result { font-size: var(--font-20); flex: none; padding: var(--space-1) var(--space-2); border-radius: var(--radius-xs); background: var(--color-brand-soft); }
.result.exact { color: var(--color-state-locked); background: var(--color-state-hit-soft); }
.result.pending, .result.miss { color: var(--text-muted); background: var(--color-state-done-soft); }

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.filter-chip {
  padding: var(--space-2) var(--space-4);
  border: var(--border-hairline) solid var(--border-glass-strong);
  border-radius: var(--radius-card);
  background: var(--secondary-glass);
  color: var(--text-primary);
  font-size: var(--font-22);
}

.filter-chip.disabled {
  color: var(--text-muted);
}

.filter-error {
  margin-bottom: var(--space-4);
  color: var(--text-danger);
  font-size: var(--font-22);
}

.share-entry {
  margin: 0 0 var(--space-6);
  padding: var(--space-3) var(--space-4);
  color: var(--text-primary);
  background: var(--surface-ghost);
  border-radius: var(--radius-card);
  font-size: var(--font-22);
  line-height: 1.6;
}

.share-sheet-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.46);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.share-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6fbf5;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -24rpx 80rpx rgba(14, 45, 32, 0.22);
  overflow-y: auto;
}

.share-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.share-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.share-sheet-close {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: var(--surface-ghost);
  color: var(--text-secondary);
  font-size: 32rpx;
  line-height: 56rpx;
  text-align: center;
}

.share-sheet-section + .share-sheet-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: var(--border-hairline) solid var(--border-subtle);
}

.share-sheet-label {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.share-choice-list,
.share-picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.share-choice-chip {
  margin: 0;
  padding: 14rpx 22rpx;
  border: var(--border-hairline) solid var(--border-glass-strong);
  border-radius: var(--radius-card);
  background: #ffffff;
  color: var(--text-primary);
  font-size: 24rpx;
  line-height: 1.4;
}

.share-confirm-btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-card);
  background: var(--cta-background);
  color: var(--text-on-brand);
  font-size: 28rpx;
  font-weight: 700;
}

.share-confirm-btn[disabled] {
  opacity: 0.5;
}

.share-sheet-empty {
  padding: 24rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.share-retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
}
