<view class="page">
  <image class="stadium-background" src="/assets/images/home-pitch-bg.webp" mode="aspectFill" />
  <view class="stadium-overlay"></view>
  <view class="secondary-content">
  <view class="page-subtitle">按比赛周分组，最新的排在前</view>
  <view wx:if="{{filterReady && leagues.length > 0}}" class="filter-row">
    <picker range="{{leagueOptions}}" value="{{leagueIndex}}" bindchange="onLeagueChange">
      <view class="filter-chip">{{leagueOptions[leagueIndex]}}</view>
    </picker>
    <picker range="{{seasonOptions}}" value="{{seasonIndex}}" bindchange="onSeasonChange" disabled="{{leagueIndex === 0}}">
      <view class="filter-chip {{leagueIndex === 0 ? 'disabled' : ''}}">{{seasonOptions[seasonIndex]}}</view>
    </picker>
  </view>
  <view wx:if="{{filterError}}" class="filter-error">
    <text>{{filterError}}</text>
    <button bindtap="onFilterRetry">重试</button>
  </view>
  <button wx:if="{{state === 'list' || state === 'empty'}}" class="share-entry" bindtap="onShareCardTap">
    <text>分享轮次成绩</text>
    <text class="share-entry-arrow">›</text>
  </button>
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'unauthorized'}}" class="state-panel">
    <text>登录后查看你的预测</text>
    <button bindtap="onSessionTap">登录</button>
  </view>
  <view wx:elif="{{state === 'userDeleted'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'userNotFound'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'empty'}}" class="empty-state">
    <text>{{emptyText}}</text>
    <button bindtap="onMatchesTap">{{goPredictText}}</button>
  </view>
  <view wx:elif="{{state === 'error'}}" class="state-panel">
    <text>{{errorMessage}}</text>
    <button bindtap="onRetry">重试</button>
  </view>
  <view wx:else>
    <view wx:for="{{weeks}}" wx:for-item="week" wx:key="key" class="week-group glass-card">
      <view class="week-heading">{{week.label}}</view>
      <view
        wx:for="{{week.items}}"
        wx:for-item="prediction"
        wx:key="prediction_id"
        class="prediction-card"
        data-match-id="{{prediction.match_id}}"
        bindtap="onCardTap"
      >
        <view class="card-head">
          <view class="league"><image src="{{prediction.leagueLogo}}" mode="aspectFit"></image><text>{{prediction.leagueRoundText}}</text></view>
          <text class="status">{{prediction.statusText}}</text>
        </view>
        <view class="match-row">
          <view class="teams-inline">
            <view class="team"><image src="{{prediction.homeLogo}}" mode="aspectFit"></image><text>{{prediction.homeNameZh}}</text></view>
            <text class="versus">vs</text>
            <view class="team away"><image src="{{prediction.awayLogo}}" mode="aspectFit"></image><text>{{prediction.awayNameZh}}</text></view>
          </view>
          <text class="prediction-points">{{prediction.pointsText}}</text>
        </view>
        <view class="prediction-detail">
          <view class="scores">
            <text>预测 {{prediction.predictionText}}</text>
            <text class="actual">实际 {{prediction.actualText}}</text>
          </view>
          <text class="result {{prediction.exact_hit ? 'exact' : prediction.wdl_hit ? 'hit' : prediction.match_score === null ? 'pending' : 'miss'}}">{{prediction.resultText}}</text>
        </view>
        <view class="card-foot"><text>{{prediction.kickoffText}}</text></view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <button wx:if="{{hasMore}}" class="more" bindtap="onMore" disabled="{{loadingMore}}">
      {{loadingMore ? '加载中…' : (items.length === 0 ? '加载更早记录' : '加载更多')}}
    </button>
    <view wx:if="{{!hasMore && !errorMessage}}" class="history-end">{{endText}}</view>
  </view>
  </view>
  <view wx:if="{{showShareSheet}}" class="share-sheet-backdrop" bindtap="onCloseShareSheet">
    <view class="share-sheet" catchtap="onStopPropagation">
      <view class="share-sheet-header">
        <text class="share-sheet-title">选择要分享的轮次</text>
        <button class="share-sheet-close" bindtap="onCloseShareSheet" aria-label="关闭">×</button>
      </view>
      <view wx:if="{{shareRoundChoices.length > 0}}" class="share-sheet-section">
        <view class="share-sheet-label">已有预测记录的轮次</view>
        <view class="share-choice-list">
          <button
            wx:for="{{shareRoundChoices}}"
            wx:for-item="choice"
            wx:key="key"
            class="share-choice-chip"
            data-league-id="{{choice.leagueId}}"
            data-season-id="{{choice.seasonId}}"
            data-round-id="{{choice.roundId}}"
            bindtap="onShareChoiceTap"
          >{{choice.label}}</button>
        </view>
      </view>
      <view wx:if="{{filterReady && leagues.length > 0}}" class="share-sheet-section">
        <view class="share-sheet-label">按联赛 / 赛季 / 轮次选择</view>
        <view class="share-picker-row">
          <picker range="{{shareLeagueOptions}}" value="{{shareLeagueIndex}}" bindchange="onShareLeagueChange">
            <view class="filter-chip">{{shareLeagueOptions[shareLeagueIndex]}}</view>
          </picker>
          <picker range="{{shareSeasonOptions}}" value="{{shareSeasonIndex}}" bindchange="onShareSeasonChange" disabled="{{shareLeagueIndex === 0}}">
            <view class="filter-chip {{shareLeagueIndex === 0 ? 'disabled' : ''}}">{{shareSeasonOptions[shareSeasonIndex]}}</view>
          </picker>
          <picker range="{{shareRoundOptions}}" value="{{shareRoundIndex}}" bindchange="onShareRoundChange" disabled="{{shareSeasonIndex === 0}}">
            <view class="filter-chip {{shareSeasonIndex === 0 ? 'disabled' : ''}}">{{shareRoundOptions[shareRoundIndex]}}</view>
          </picker>
        </view>
        <button
          class="share-confirm-btn"
          bindtap="onShareConfirm"
          disabled="{{!shareLeagueId || !shareSeasonId || !shareRoundId}}"
        >生成分享卡</button>
      </view>
      <view wx:elif="{{shareRoundChoices.length === 0}}" class="share-sheet-empty">
        <text>{{filterError || '请先加载联赛与轮次选项后再选择分享轮次'}}</text>
        <button wx:if="{{filterError}}" class="share-retry-btn" bindtap="onFilterRetry">重试加载选项</button>
      </view>
    </view>
  </view>
</view>
<app-tab-bar active-index="2" />
