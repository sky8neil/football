<view class="page">
  <view class="page-title">最近预测</view>
  <view wx:if="{{state === 'loading'}}" class="loading"></view>
  <view wx:elif="{{state === 'unauthorized'}}" class="state-panel">
    <text>登录后查看你的预测</text>
    <button bindtap="onSessionTap">登录</button>
  </view>
  <view wx:elif="{{state === 'userDeleted'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'userNotFound'}}" class="state-panel">{{errorMessage}}</view>
  <view wx:elif="{{state === 'empty'}}" class="empty-state">
    <text>{{emptyText}}</text>
    <button bindtap="onMatchesTap">{{goPredictText}}</button>
  </view>
  <view wx:elif="{{state === 'error'}}" class="state-panel">
    <text>{{errorMessage}}</text>
    <button bindtap="onRetry">重试</button>
  </view>
  <view wx:else>
    <view wx:for="{{weeks}}" wx:for-item="week" wx:key="key" class="week-group">
      <view class="week-heading">{{week.label}}</view>
      <view
        wx:for="{{week.items}}"
        wx:for-item="prediction"
        wx:key="prediction_id"
        class="prediction-card"
        data-match-id="{{prediction.match_id}}"
        bindtap="onCardTap"
      >
        <view class="card-head">
          <view class="league"><image src="{{prediction.leagueLogo}}" mode="aspectFit"></image><text>{{prediction.leagueName}} · {{prediction.round_id}}</text></view>
          <text class="status">{{prediction.statusText}}</text>
        </view>
        <view class="match-row">
          <view class="team"><image src="{{prediction.homeLogo}}" mode="aspectFit"></image><text>{{prediction.homeName}}</text></view>
          <view class="scores">
            <text>{{prediction.predictionText}}</text>
            <text class="actual">实际 {{prediction.actualText}}</text>
          </view>
          <view class="team away"><image src="{{prediction.awayLogo}}" mode="aspectFit"></image><text>{{prediction.awayName}}</text></view>
        </view>
        <view class="card-foot">
          <text>{{prediction.kickoffText}}</text>
          <text class="result">{{prediction.resultText}} · {{prediction.pointsText}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    <button wx:if="{{hasMore}}" class="more" bindtap="onMore" disabled="{{loadingMore}}">
      {{loadingMore ? '加载中…' : '加载更多'}}
    </button>
    <view wx:if="{{!hasMore && !errorMessage}}" class="history-end">{{endText}}</view>
  </view>
</view>
