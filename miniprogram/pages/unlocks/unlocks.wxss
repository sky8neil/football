@import "../../styles/secondary-pages.wxss";

.page {
  padding: 24rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.num {
  font-variant-numeric: tabular-nums;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  margin: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.page-subtitle {
  margin: 6rpx 0 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.glass-card.strong {
  background: rgba(255, 255, 255, 0.78);
}

.dark-hero {
  background: var(--secondary-dark);
  border: 2rpx solid var(--secondary-dark-border);
  border-radius: var(--radius-card);
  box-shadow: var(--secondary-dark-shadow);
  color: var(--white);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.summary-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: var(--secondary-accent);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-count {
  margin: 8rpx 0 4rpx;
  font-size: 52rpx;
  font-weight: 750;
  line-height: 1.15;
}

.hero-count-prefix {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  margin-right: 8rpx;
}

.hero-count-sub {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  margin-left: 8rpx;
}

.hero-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
  line-height: 1.5;
}

.hero-emblem {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: rgba(185, 240, 143, 0.16);
  border: 2rpx solid rgba(185, 240, 143, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.hero-emblem-img {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.95;
}

.unlock-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.unlock-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx 28rpx 32rpx;
  margin-bottom: 0;
  overflow: hidden;
}

.unlock-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 99rpx;
  background: var(--color-state-success);
}

.unlock-card.is-locked::before {
  background: var(--color-state-done);
}

.unlock-badge-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-solid);
  border: 2rpx solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
}

.unlock-card.is-locked .unlock-badge-box {
  background: var(--slate-200);
  border-color: rgba(113, 128, 150, 0.22);
}

.unlock-threshold-num {
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1;
  color: var(--text-positive);
}

.unlock-card.is-locked .unlock-threshold-num {
  color: var(--text-muted);
}

.unlock-threshold-unit {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.unlock-body {
  flex: 1;
  min-width: 0;
}

.unlock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.unlock-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}

.unlock-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.unlock-time {
  margin-top: 0;
  font-size: 22rpx;
  color: var(--text-muted);
  white-space: nowrap;
  flex: none;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
  flex: none;
}

.chip-hit {
  background: var(--color-state-hit-soft);
  color: var(--color-state-locked);
}

.chip-done {
  background: var(--color-state-done-soft);
  color: var(--text-secondary);
}

.rule-footer {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.state-panel {
  text-align: center;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.state-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: var(--color-brand-soft);
  color: var(--text-positive);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}

.state-icon.is-ball {
  background: var(--mark-gradient);
  box-shadow: var(--shadow-mark);
}

.state-icon.is-danger {
  background: #fef3f2;
  color: #b42318;
}

.state-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 36rpx;
}

.loading .state-desc {
  margin-bottom: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  margin: 0;
  box-sizing: border-box;
}

.btn-primary {
  min-width: 296rpx;
  height: 80rpx;
  padding: 0 36rpx;
  background: var(--cta-background);
  color: var(--text-on-brand);
  box-shadow: var(--shadow-floating);
}

.btn-ghost {
  min-width: 256rpx;
  height: 72rpx;
  padding: 0 32rpx;
  background: var(--surface-ghost);
  border: 2rpx solid var(--border-glass-strong);
  color: var(--text-primary);
  font-weight: 600;
  font-size: 26rpx;
}
