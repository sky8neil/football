<view class="page">
  <image class="stadium-background" src="/assets/images/baseline-pitch.webp" mode="aspectFill" />
  <view class="stadium-overlay"></view>

  <view class="secondary-content">
    <view class="page-header">
      <view class="page-title">解锁记录</view>
      <view class="page-subtitle">生涯累计积分达标后自动记录，永不回收。</view>
    </view>

    <view wx:if="{{state === 'loading'}}" class="glass-card strong state-panel loading">
      <view class="state-desc">正在加载解锁记录…</view>
    </view>

    <view wx:elif="{{state === 'empty'}}" class="glass-card strong state-panel empty">
      <view class="state-icon">
        <image class="state-icon-img" src="/assets/icons/icon-ball.png" mode="aspectFit" />
      </view>
      <view class="state-title empty-title">暂无解锁记录</view>
      <view class="state-desc empty-copy">解锁按生涯积分达标后自动记录；已解锁记录不会因赛果修正而回收。</view>
      <button class="btn btn-primary" bindtap="onGoPredict">去预测</button>
    </view>

    <view wx:elif="{{state === 'unauthorized'}}" class="glass-card strong state-panel error">
      <view class="state-icon">🔒</view>
      <view class="state-title">登录后查看解锁记录</view>
      <view class="state-desc">{{errorMessage || '登录微信账号后，即可同步查看你的生涯积分里程碑记录。'}}</view>
      <button class="btn btn-primary" bindtap="onLoginTap">去登录</button>
    </view>

    <view wx:elif="{{state === 'userNotFound'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">用户不存在</view>
      <view class="state-desc">{{errorMessage}}</view>
    </view>

    <view wx:elif="{{state === 'userDeleted'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">当前账号不可用</view>
      <view class="state-desc">{{errorMessage}}</view>
    </view>

    <view wx:elif="{{state === 'validationError'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">暂时无法加载解锁记录</view>
      <view class="state-desc">{{errorMessage}}</view>
      <button class="btn btn-ghost" bindtap="onRetry">重试</button>
    </view>

    <view wx:elif="{{state === 'rateLimited'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">请求过于频繁</view>
      <view class="state-desc">{{errorMessage}}</view>
    </view>

    <view wx:elif="{{state === 'serverError'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">暂时无法加载解锁记录</view>
      <view class="state-desc">{{errorMessage}}</view>
      <button class="btn btn-ghost" bindtap="onRetry">重试</button>
    </view>

    <view wx:elif="{{state === 'error'}}" class="glass-card strong state-panel error">
      <view class="state-icon is-danger">!</view>
      <view class="state-title">暂时无法加载解锁记录</view>
      <view class="state-desc">{{errorMessage}}</view>
      <button class="btn btn-ghost" bindtap="onRetry">重试</button>
    </view>

    <view wx:elif="{{state === 'list'}}">
      <view class="dark-hero summary-hero">
        <view class="hero-copy">
          <view class="hero-eyebrow">生涯里程碑记录</view>
          <view class="hero-count num">
            <text class="hero-count-prefix">已记录</text>
            <text>{{unlockedCount}}</text>
            <text class="hero-count-sub">项里程碑</text>
          </view>
          <view class="hero-note">达标后自动写入记录 · 不因赛果修正而回收</view>
        </view>
        <view class="hero-emblem">
          <image class="hero-emblem-img" src="/assets/icons/ui-rules.png" mode="aspectFit" />
        </view>
      </view>

      <view class="unlock-list">
        <view wx:for="{{items}}" wx:key="unlock_code" class="glass-card strong unlock-card">
          <view class="unlock-badge-box">
            <text class="unlock-threshold-num num">{{item.threshold_points}}</text>
            <text class="unlock-threshold-unit">生涯分</text>
          </view>
          <view class="unlock-body">
            <view class="unlock-head">
              <text class="unlock-name">{{item.label}}</text>
              <text class="chip chip-hit">已解锁</text>
            </view>
            <view class="unlock-meta">解锁门槛：生涯累计 {{item.threshold_points}} 分 · 进度 {{item.progressText}}</view>
            <view wx:if="{{item.unlockedText}}" class="unlock-time">记录于 {{item.unlockedText}}</view>
          </view>
        </view>
      </view>

      <view class="rule-footer">仅展示生涯积分里程碑记录，不含装扮穿戴或数值加成。</view>
    </view>
  </view>
</view>
