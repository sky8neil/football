
page {

  

  
  --green-100: #d5ead4;   
  --green-300: #9ee48a;   
  --green-400: #7ed56f;   
  --green-500: #62c453;   
  --green-700: #2f8a3a;   
  --green-800: #1a5c26;   
  --green-900: #163024;   

  
  --mint-50: #f4fbf0;     
  --mint-100: #e8f8df;    
  --mint-300: #dcead9;    

  
  --teal-50: #e8fbf8;     
  --teal-500: #3aa37a;    
  --teal-700: #0b7f70;    

  
  --orange-50: #fff1e8;   
  --orange-500: #f08a3c;  

  
  --red-500: #c05621;     
  --navy-700: #1a2b44;    
  --navy-900: #122033;    
  --slate-200: #f3f6fb;   
  --neutral-700: #718096; 
  --white: #ffffff;

  
  --ink-700: #3b4f43;     
  --ink-600: #42564a;     

  
  --alpha-white-45: rgba(255, 255, 255, 0.45);
  --alpha-white-48: rgba(255, 255, 255, 0.48);
  --alpha-white-50: rgba(255, 255, 255, 0.50);
  --alpha-white-54: rgba(255, 255, 255, 0.54);
  --alpha-white-58: rgba(255, 255, 255, 0.58);
  --alpha-white-60: rgba(255, 255, 255, 0.60);
  --alpha-white-66: rgba(255, 255, 255, 0.66);
  --alpha-white-72: rgba(255, 255, 255, 0.72);
  --alpha-white-82: rgba(255, 255, 255, 0.82);
  --alpha-white-88: rgba(255, 255, 255, 0.88);

  
  --font-family-cn: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-family-number: "Outfit", -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;

  
  --font-18: 9px;
  --font-20: 10px;
  --font-22: 11px;
  --font-24: 12px;
  --font-26: 13px;
  --font-30: 15px;
  --font-32: 16px;
  --font-36: 18px;

  
  --weight-regular: 400;
  --weight-medium: 600;
  --weight-semibold: 650;
  --weight-bold: 700;
  --weight-heavy: 750;

  
  --space-1: 2px;
  --space-2: 4px;
  --space-3: 6px;
  --space-4: 8px;
  --space-5: 10px;
  --space-6: 12px;
  --space-7: 14px;
  --space-8: 16px;
  --space-9: 18px;
  --space-10: 20px;

  
  --radius-xs: 8px;     
  --radius-sm: 9px;     
  --radius-md: 10px;     
  --radius-lg: 12px;     
  --radius-xl: 14px;     
  --radius-card: 16px;   
  --radius-tray: 20px;   
  --radius-pill: 49.5px;   

  
  --duration-shift: 180ms;    
  --duration-enter: 240ms;    
  --duration-predict: 320ms;  
  --ease-standard: ease;
  --ease-emphasized: cubic-bezier(0.4, 0, 0.2, 1);
  

  
  --blur-card: 18px;
  --blur-tray: 7px;

  
  --border-hairline: 1px;    

  

  
  --text-primary: var(--green-900);
  --text-secondary: var(--ink-700);
  --text-muted: var(--ink-600);
  --text-on-brand: var(--green-900);      
  --text-positive: var(--green-800);      
  --text-danger: var(--red-500);

  
  --color-brand-primary: var(--green-400);
  --color-brand-primary-pressed: var(--green-700);
  --color-brand-soft: var(--mint-100);

  
  --color-state-live: var(--orange-500);
  --color-state-live-soft: var(--orange-50);
  --color-state-done: var(--neutral-700);
  --color-state-done-soft: var(--slate-200);
  --color-state-success: var(--teal-500);
  --color-state-locked: var(--teal-700);
  --color-state-hit-soft: var(--teal-50);

  
  --surface-canvas: var(--green-100);                       
  --surface-page: radial-gradient(120% 56% at 92% -8%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 46%), radial-gradient(80% 40% at 0% 18%, rgba(126,213,111,0.22) 0%, rgba(126,213,111,0) 55%), linear-gradient(180deg, #f4fbf1 0%, #eef8ef 42%, #f3faf2 100%);
                                                            
  --surface-card: var(--alpha-white-54);                    
  --surface-card-strong: var(--alpha-white-58);             
  --surface-pred: var(--alpha-white-50);                    
  --surface-tray: var(--alpha-white-48);                    
  --surface-ghost: var(--alpha-white-72);                   
  --surface-date-active: var(--white);                      
  --surface-solid: linear-gradient(180deg, var(--mint-50), var(--mint-100));   
  --surface-solid-dark: linear-gradient(180deg, var(--navy-700), var(--navy-900));

  
  --border-subtle: var(--mint-300);
  --border-glass-strong: var(--alpha-white-88);             
  --border-glass: var(--alpha-white-82);                    
  --border-pred: var(--alpha-white-66);                     
  --border-dark: var(--navy-900);

  
  --shadow-card: 0 12px 30px rgba(23, 60, 35, 0.10), inset 0 1px 0 var(--alpha-white-60);
  --shadow-floating: 0 8px 16px rgba(63, 138, 72, 0.22), inset 0 1px 0 var(--alpha-white-45);
  --shadow-sm: 0 4px 10px rgba(63, 138, 72, 0.05);
  --shadow-tray: inset 0 1px 0 var(--alpha-white-82), 0 6px 16px rgba(47, 106, 62, 0.05);  
  --shadow-mark: 0 8px 16px rgba(63, 138, 72, 0.28), inset 0 1px 0 var(--alpha-white-45);
  --shadow-bug: 0 2px 6px rgba(31, 84, 45, 0.08);

  

  
  --page-padding-inline: var(--space-8);                                     
  --page-padding-bottom: calc(34px + env(safe-area-inset-bottom));          
  --topbar-offset: 40px;                                                     
  --topbar-height: 44px;
  --home-spacer-top: 76px;                                                   
  --home-tray-offset: var(--space-5);                                        

  
  --mark-size: 32px;
  --mark-radius: var(--radius-md);
  --mark-ball-size: 18px;
  --mark-gradient: linear-gradient(160deg, #9ee48a 0%, #4caf50 100%);

  
  --tray-radius: var(--radius-tray);
  --tray-min-height: 56px;
  --tray-cell-width: 52px;
  --tray-cell-height: 46px;
  --tray-logo-size: 28px;

  
  --date-width: 56px;
  --date-height: 48px;
  --date-radius: var(--radius-xl);

  
  --match-card-radius: var(--radius-card);
  --match-card-background: var(--surface-card);
  --match-card-background-strong: var(--surface-card-strong);
  --match-card-border: var(--border-hairline) solid var(--border-glass-strong);
  --match-card-shadow: var(--shadow-card);
  --match-card-blur: var(--blur-card);
  --match-card-gap: var(--space-5);                       
  --match-card-padding: 12px 12px 12px 14px;
  --match-card-bar-width: 3px;                           
  --crest-size: 36px;

  
  --bug-size: 56px;
  --bug-radius: var(--radius-xl);

  
  --pred-radius: var(--radius-lg);
  --pred-background: var(--surface-pred);
  --pred-border: var(--border-hairline) solid var(--border-pred);
  --pred-max-height: 260px;
  --stepper-button-size: 28px;
  --stepper-team-logo-size: 20px;
  --stepper-value-width: 20px;

  
  --cta-background: linear-gradient(180deg, var(--green-300), var(--green-500));
  --cta-height: 36px;
  --submit-button-height: 34px;
  --ghost-button-height: 32px;
  --status-chip-height: 20px;

  


  --ui-ink: #163024;
  --ui-secondary: #42564a;
  --ui-muted: #52665b;
  --ui-positive: #1a5c26;
  --ui-selected: #2f8a3a;
  --ui-line: rgba(255,255,255,.88);
  --ui-card: rgba(255,255,255,.68);
  --ui-shadow: 0 8px 24px rgba(23,60,35,.08);
  --ui-font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-family-cn: var(--ui-font);
  --font-family-number: var(--ui-font);
  --text-primary: var(--ui-ink);
  --text-secondary: var(--ui-secondary);
  --text-muted: var(--ui-muted);
  --text-positive: var(--ui-positive);
  --ink: var(--ui-ink);
  --ink-soft: var(--ui-secondary);
  --ink-faint: var(--ui-muted);
  --radius-card: 16px;
  --surface-card: var(--ui-card);
  --surface-card-strong: rgba(255,255,255,.76);
  --shadow-card: var(--ui-shadow);


  --navy-700: #1f4d36;
  --navy-900: #0e2d20;
  --deep-a: #1f4d36;
  --deep-b: #0e2d20;
  --deep-glow: rgba(185,240,143,.20);
  --deep-accent: #b9f08f;

}
