/* ============================================================================
   赛事预言家 V1 Design System — Tokens
   ============================================================================
   Source of Truth：**当前首页实现**（miniprogram/pages/matches/）反向提炼，
   不是「先写 token 再让首页迁就」。取值全部来自 computed 快照
   （docs/design/baselines/home-computed-before.json），不是设计稿推想值。

   文档：docs/UI_DESIGN_SYSTEM.md（V1）
   改动流程：改 token → 重跑快照 → `diff-home-visuals.py` 必须报「逐项一致性 ✅」

   三层结构（只允许这三层，禁止跨层引用反向）：
     1) Primitive   物理值：色阶 / 透明度 / 字号 / 字重 / 间距 / 圆角 / 时长 / 模糊
     2) Semantic    用途语义：文字 / 品牌 / 状态 / surface / 边框 / 阴影
     3) Component   组件规范：match-card / tray / date / cta / submit-button / topbar …

   状态标记：
     Frozen      首页已验证并已接线（改它必须重跑快照回归）
     Provisional 首页未用，留给后续页面（排行榜 / 我的预测 / 我的 / 详情），
                 未经过页面验证，不属于冻结视觉
   ============================================================================ */
page {
  /* ==========================================================================
     1. Primitive — 物理值
     ========================================================================== */

  /* 1.1 绿系（品牌） */
  --green-100: #d5ead4;   /* 页面最底 canvas */
  --green-300: #9ee48a;   /* 品牌 mark 渐变起点 / CTA 渐变起点 */
  --green-400: #7ed56f;   /* 品牌主色 */
  --green-500: #62c453;   /* mark/CTA 渐变终点 */
  --green-700: #2f8a3a;   /* 主色按下态 */
  --green-800: #1a5c26;   /* 正向分数文字（背景图上实测 5.0:1） */
  --green-900: #163024;   /* 主文字 */

  /* 1.2 薄荷（品牌浅面） */
  --mint-50: #f4fbf0;     /* 实色面渐变起点 */
  --mint-100: #e8f8df;    /* 品牌软底 / 实色面渐变终点 */
  --mint-300: #dcead9;    /* 细边框 */

  /* 1.3 青（成功 / 锁定） */
  --teal-50: #e8fbf8;     /* 命中提示底 */
  --teal-500: #3aa37a;    /* 已提交 / 提交成功 */
  --teal-700: #0b7f70;    /* 已锁定 */

  /* 1.4 橙（进行中） */
  --orange-50: #fff1e8;   /* 进行中标签底 */
  --orange-500: #f08a3c;  /* 进行中 */

  /* 1.5 红 / 蓝 / 中性 */
  --red-500: #c05621;     /* 错误文字 */
  --navy-700: #1a2b44;    /* 深色比分块渐变起点 */
  --navy-900: #122033;    /* 深色比分块渐变终点 / 描边 */
  --slate-200: #f3f6fb;   /* 中性标签底 */
  --neutral-700: #718096; /* 完场 */
  --white: #ffffff;

  /* 1.6 文字专用深档（母版页在球场照片上实测 5.0–7.9:1；
         旧的 #5b7166 / #86a092 只有 1.1–4.7:1，已废弃） */
  --ink-700: #3b4f43;     /* 次级文字 */
  --ink-600: #42564a;     /* 弱文字 */

  /* 1.7 半透明白（玻璃 / 描边 / 内高光用）—— 只收录真实在用的档位 */
  --alpha-white-45: rgba(255, 255, 255, 0.45);
  --alpha-white-48: rgba(255, 255, 255, 0.48);
  --alpha-white-50: rgba(255, 255, 255, 0.50);
  --alpha-white-54: rgba(255, 255, 255, 0.54);
  --alpha-white-58: rgba(255, 255, 255, 0.58);
  --alpha-white-60: rgba(255, 255, 255, 0.60);
  --alpha-white-66: rgba(255, 255, 255, 0.66);
  --alpha-white-72: rgba(255, 255, 255, 0.72);
  --alpha-white-82: rgba(255, 255, 255, 0.82);
  --alpha-white-88: rgba(255, 255, 255, 0.88);

  /* 1.8 字体族（小程序不加载外部字体；数字族缺字时回落系统无衬线） */
  --font-family-cn: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-family-number: "Outfit", -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;

  /* 1.9 字号（rpx，1rpx = 0.5px @375） */
  --font-18: 18rpx;
  --font-20: 20rpx;
  --font-22: 22rpx;
  --font-24: 24rpx;
  --font-26: 26rpx;
  --font-30: 30rpx;
  --font-32: 32rpx;
  --font-36: 36rpx;

  /* 1.10 字重 */
  --weight-regular: 400;
  --weight-medium: 600;
  --weight-semibold: 650;
  --weight-bold: 700;
  --weight-heavy: 750;

  /* 1.11 间距（rpx）—— 只收录首页真实出现的档位 */
  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-5: 20rpx;
  --space-6: 24rpx;
  --space-7: 28rpx;
  --space-8: 32rpx;
  --space-9: 36rpx;
  --space-10: 40rpx;

  /* 1.12 圆角 */
  --radius-xs: 16rpx;     /* 状态标签 / 步进按钮 */
  --radius-sm: 18rpx;     /* 次级按钮 */
  --radius-md: 20rpx;     /* CTA / 品牌 mark */
  --radius-lg: 24rpx;     /* 预测编辑区 */
  --radius-xl: 28rpx;     /* 比分块 / 日期格 */
  --radius-card: 32rpx;   /* 比赛卡 */
  --radius-tray: 40rpx;   /* 联赛托盘 */
  --radius-pill: 99rpx;   /* 选中下划线 */

  /* 1.13 动效（V1 定格值：180 / 240 / 320ms。
         旧 token 的 120 / 220ms 与首页实装不符，已废弃） */
  --duration-shift: 180ms;    /* 列表切换（退场） */
  --duration-enter: 240ms;    /* 列表切换（入场） */
  --duration-predict: 320ms;  /* 预测区展开 / 提交成功 */
  --ease-standard: ease;
  --ease-emphasized: cubic-bezier(0.4, 0, 0.2, 1);
  /* 注：@keyframes 里的 8rpx 位移刻意保留字面量 —— var() 在关键帧中的中间态
     无法被 computed 快照回归覆盖，抽象化只会换来「测不到的改动」。 */

  /* 1.14 模糊 */
  --blur-card: 36rpx;
  --blur-tray: 14rpx;

  /* 1.15 描边宽度 */
  --border-hairline: 2rpx;    /* = 1px @375 */

  /* ==========================================================================
     2. Semantic — 用途语义
     ========================================================================== */

  /* 2.1 文字 */
  --text-primary: var(--green-900);
  --text-secondary: var(--ink-700);
  --text-muted: var(--ink-600);
  --text-on-brand: var(--green-900);      /* 绿底按钮上的文字 */
  --text-positive: var(--green-800);      /* 最近成绩 +K */
  --text-danger: var(--red-500);

  /* 2.2 品牌 */
  --color-brand-primary: var(--green-400);
  --color-brand-primary-pressed: var(--green-700);
  --color-brand-soft: var(--mint-100);

  /* 2.3 状态 */
  --color-state-live: var(--orange-500);
  --color-state-live-soft: var(--orange-50);
  --color-state-done: var(--neutral-700);
  --color-state-done-soft: var(--slate-200);
  --color-state-success: var(--teal-500);
  --color-state-locked: var(--teal-700);
  --color-state-hit-soft: var(--teal-50);

  /* 2.4 Surface（首页玻璃档位：白底负责可读性，blur 负责观感） */
  --surface-canvas: var(--green-100);                       /* 最底画布 */
  --surface-page: radial-gradient(120% 56% at 92% -8%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 46%), radial-gradient(80% 40% at 0% 18%, rgba(126,213,111,0.22) 0%, rgba(126,213,111,0) 55%), linear-gradient(180deg, #f4fbf1 0%, #eef8ef 42%, #f3faf2 100%);
                                                            /* 兜底底色：正常被球场照片盖住 */
  --surface-card: var(--alpha-white-54);                    /* 比赛卡 */
  --surface-card-strong: var(--alpha-white-58);             /* 可预测卡 */
  --surface-pred: var(--alpha-white-50);                    /* 卡内预测编辑区 */
  --surface-tray: var(--alpha-white-48);                    /* 联赛托盘 */
  --surface-ghost: var(--alpha-white-72);                   /* 次级按钮（更多 / 重试） */
  --surface-date-active: var(--white);                      /* 日期选中态：实心白 */
  --surface-solid: linear-gradient(180deg, var(--mint-50), var(--mint-100));   /* 比分块：实色，不参与玻璃化 */
  --surface-solid-dark: linear-gradient(180deg, var(--navy-700), var(--navy-900));

  /* 2.5 边框 */
  --border-subtle: var(--mint-300);
  --border-glass-strong: var(--alpha-white-88);             /* 卡面描边 */
  --border-glass: var(--alpha-white-82);                    /* 托盘描边 */
  --border-pred: var(--alpha-white-66);                     /* 预测编辑区描边 */
  --border-dark: var(--navy-900);

  /* 2.6 阴影 */
  --shadow-card: 0 24rpx 60rpx rgba(23, 60, 35, 0.10), inset 0 2rpx 0 var(--alpha-white-60);
  --shadow-floating: 0 16rpx 32rpx rgba(63, 138, 72, 0.22), inset 0 2rpx 0 var(--alpha-white-45);
  --shadow-sm: 0 8rpx 20rpx rgba(63, 138, 72, 0.05);
  --shadow-tray: inset 0 2rpx 0 var(--alpha-white-82), 0 12rpx 32rpx rgba(47, 106, 62, 0.05);  /* 内高光 = --border-glass 同值，直接用 primitive */
  --shadow-mark: 0 16rpx 32rpx rgba(63, 138, 72, 0.28), inset 0 2rpx 0 var(--alpha-white-45);
  --shadow-bug: 0 4rpx 12rpx rgba(31, 84, 45, 0.08);

  /* ==========================================================================
     3. Component — 组件规范（只在组件有明确独立规范时建立）
     ========================================================================== */

  /* 3.1 页面骨架 */
  --page-padding-inline: var(--space-8);                                     /* 32rpx */
  --page-padding-bottom: calc(68rpx + env(safe-area-inset-bottom));          /* 让开 tabBar */
  --topbar-offset: 40px;                                                     /* 顶栏距安全区顶 */
  --topbar-height: 44px;
  --home-spacer-top: 76px;                                                   /* 顶栏占位（含 8px 叠压余量） */
  --home-tray-offset: var(--space-5);                                        /* 联赛托盘上间距 20rpx */

  /* 3.2 品牌 mark */
  --mark-size: 64rpx;
  --mark-radius: var(--radius-md);
  --mark-ball-size: 36rpx;
  --mark-gradient: linear-gradient(160deg, #9ee48a 0%, #4caf50 100%);

  /* 3.3 联赛托盘 */
  --tray-radius: var(--radius-tray);
  --tray-min-height: 112rpx;
  --tray-cell-width: 104rpx;
  --tray-cell-height: 92rpx;
  --tray-logo-size: 56rpx;

  /* 3.4 日期条 */
  --date-width: 112rpx;
  --date-height: 96rpx;
  --date-radius: var(--radius-xl);

  /* 3.5 比赛卡 */
  --match-card-radius: var(--radius-card);
  --match-card-background: var(--surface-card);
  --match-card-background-strong: var(--surface-card-strong);
  --match-card-border: var(--border-hairline) solid var(--border-glass-strong);
  --match-card-shadow: var(--shadow-card);
  --match-card-blur: var(--blur-card);
  --match-card-gap: var(--space-5);                       /* 卡间距 20rpx */
  --match-card-padding: 24rpx 24rpx 24rpx 28rpx;
  --match-card-bar-width: 6rpx;                           /* 左侧状态竖条 */
  --crest-size: 72rpx;

  /* 3.6 比分块（vs 框）—— 必须实色，不得玻璃化 */
  --bug-size: 112rpx;
  --bug-radius: var(--radius-xl);

  /* 3.7 预测编辑区 */
  --pred-radius: var(--radius-lg);
  --pred-background: var(--surface-pred);
  --pred-border: var(--border-hairline) solid var(--border-pred);
  --pred-max-height: 520rpx;
  --stepper-button-size: 56rpx;
  --stepper-team-logo-size: 40rpx;
  --stepper-value-width: 40rpx;

  /* 3.8 按钮
         交互命中区与视觉高度是两件事：这里是**视觉高度**，
         命中区规则见文档「Accessibility」（不强制把视觉高度抬到 88rpx）。 */
  --cta-background: linear-gradient(180deg, var(--green-300), var(--green-500));
  --cta-height: 72rpx;
  --submit-button-height: 68rpx;
  --ghost-button-height: 64rpx;
  --status-chip-height: 40rpx;

  /* 3.9 tabBar
         微信 tabBar 由 app.json 配置、原生渲染，当前项目未做任何样式配置，
         因此 V1 没有可提炼的 tabBar token（见文档 "tabBar" 一节）。 */
}
