# Placeholder site fragment. Replace api.example.com before use.
# Host-local Caddy must proxy to the API loopback listener in src/gateway/http.ts
# (GATEWAY_LISTEN_HOST=127.0.0.1, GATEWAY_LISTEN_PORT=8787).
# If Caddy runs in Docker, 127.0.0.1 inside the container is not the host;
# use a reachable host/bridge address instead of copying this upstream.

api.example.com {
	request_body {
		max_size 256KB
	}

	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options nosniff
		>X-Frame-Options DENY
	}

	@health path /health
	respond @health 404

	redir /admin /admin/ 308
	@admin path /admin/*
	handle @admin {
		root * /home/neilxu/football/current
		header Cache-Control "no-store"
		@admin_tests path *.test.mjs
		respond @admin_tests 404
		try_files {path} {path}/index.html =404
		file_server
	}

	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-Ip {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
			read_timeout 30s
			write_timeout 30s
			keepalive 4s
		}
	}
}
