# systemd EnvironmentFile template for VPS API and jobs.
# Copy to the server path used by the unit files, currently
# /home/neilxu/football/shared/football.env
# Do not use export. Do not commit real secrets.
# API and jobs must read the same file.
# Listen address is compiled as 127.0.0.1:8787; PORT is not read.

FOOTBALL_ENVIRONMENT=prod
FOOTBALL_REPOSITORY_BACKEND=postgres
FOOTBALL_DATABASE_URL=postgres://football_user:replace-me@127.0.0.1:5432/football
FOOTBALL_DATABASE_SCHEMA=football_prod
FOOTBALL_RESOURCE_NAMESPACE=football_prod
FOOTBALL_MATCH_CURSOR_SECRET=replace-with-stable-cursor-secret
FOOTBALL_WECHAT_APP_ID=replace-with-miniprogram-appid
FOOTBALL_WECHAT_APP_SECRET=replace-with-server-side-appsecret
FOOTBALL_SESSION_TTL_SECONDS=604800

FOOTBALL_PROVIDER_SOURCES=fd,bsd
FOOTBALL_SYNC_PROFILE=prod
FOOTBALL_SYNC_LEAGUES=premier_league,la_liga,serie_a,bundesliga,ligue_1,chinese_super_league
FOOTBALL_PROVIDER_KEY_FD_1=replace-me
FOOTBALL_PROVIDER_KEY_FD_2=replace-me
FOOTBALL_PROVIDER_KEY_BSD=replace-me
FOOTBALL_PROVIDER_MIN_GAP_SECONDS=3

# Production must leave these unset:
# FOOTBALL_MOCK_TRUSTED_OPENID
# FOOTBALL_SEED_SCENARIO
# FOOTBALL_CLOUD_ENVIRONMENT_ID
# TENCENTCLOUD_SECRET_ID
# TENCENTCLOUD_SECRET_KEY
