[Unit]
Description=Football scheduled jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=neilxu
WorkingDirectory=/home/neilxu/football/current
EnvironmentFile=/home/neilxu/football/shared/football.env
Environment=FOOTBALL_PG_POOL_MAX=5
ExecStart=/usr/bin/node /home/neilxu/football/current/dist/jobs/tick.js --mode=realtime
TimeoutStartSec=150
