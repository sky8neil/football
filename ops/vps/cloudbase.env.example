# Cloud function environment keys for repository_backend=cloudbase.
# Set these on the `api` function in the CloudBase console, or merge via
# npm run cloudbase:function -- --apply --sync-env from a local
# .env.cloudbase.local (gitignored). Do not put Tencent SecretId/SecretKey
# on the function; those belong only to local provision/deploy scripts.

FOOTBALL_ENVIRONMENT=test
FOOTBALL_REPOSITORY_BACKEND=cloudbase
FOOTBALL_CLOUD_ENVIRONMENT_ID=replace-with-cloudbase-env-id
FOOTBALL_RESOURCE_NAMESPACE=football_test
FOOTBALL_MATCH_CURSOR_SECRET=replace-with-stable-cursor-secret

FOOTBALL_PROVIDER_SOURCES=fd,bsd
FOOTBALL_SYNC_PROFILE=test
FOOTBALL_SYNC_LEAGUES=premier_league,la_liga,serie_a,bundesliga,ligue_1,chinese_super_league
FOOTBALL_PROVIDER_KEY_FD_1=replace-me
FOOTBALL_PROVIDER_KEY_FD_2=replace-me
FOOTBALL_PROVIDER_KEY_BSD=replace-me
FOOTBALL_PROVIDER_MIN_GAP_SECONDS=3

# Production must leave this empty/unset:
# FOOTBALL_MOCK_TRUSTED_OPENID

# Not used by CloudBase runtime and must not be required:
# FOOTBALL_DATABASE_URL
# FOOTBALL_DATABASE_SCHEMA
# FOOTBALL_WECHAT_APP_ID
# FOOTBALL_WECHAT_APP_SECRET
# FOOTBALL_SESSION_TTL_SECONDS
